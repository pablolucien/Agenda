<project name="pclg-agenda" default="build" basedir="../../../..">

    <description>Builds pclg agenda</description>

    <property name="module_pclg_agenda" location="${basedir}/pclg-agenda"/>
    <property file="${basedir}/local_config.properties"/>

    <property name="src" location="${module_pclg_agenda}/src/main/java"/>
    <property name="resources" location="${module_pclg_agenda}/src/main/resources"/>
    <property name="lib_dir" value="${basedir}/../lib"/>
    <property name="build" location="${basedir}/../../build-agenda"/>
    <property name="dist" location="${basedir}/../../dist"/>
    <property name="pclg-agenda_jar_name" value="pclg-agenda.jar"/>

    <property name="properties" value="Agenda*.properties"/>

    <property name="classpath" value="
        ${lib_dir}/velocity-1.7-dep.jar:
        ${lib_dir}/lib_L&amp;F/kunststoff.jar:
        ${lib_dir}/gnu.getopt.jar:
        ${lib_dir}/jdom-1.0.jar:
        ${lib_dir}/jpatterns-0.1.jar:
        ${lib_dir}/itextpdf-5.3.4.jar:
        ${lib_dir}/jxl.jar:
        ${lib_dir}/jid3lib-0.5.4.jar:
        ${lib_dir}/javaee.jar:
        ${lib_dir}/log4j-1.2.15.jar:
        ${lib_dir}/ez-vcard-0.9.5.jar:
        ${lib_dir}/jcommander-1.27.jar:
        ${lib_dir}/docx4j-3.3.1.jar:
        ${lib_dir}/serializer-2.7.2.jar:
        ${lib_dir}/guava-18.0.jar:
        ${lib_dir}/docx4j-3.3.1.jar:
        ${lib_dir}/commons-io-1.3.2.jar:
        ${lib_dir}/slf4j-api-1.7.7.jar:
        ${lib_dir}/testng-6.8.8.jar:
        ${lib_dir}/hamcrest-all-1.3.jar:
        ${lib_dir}/awaitility-3.1.6.jar:
        ${lib_dir}/json-20180130.jar:

        ${dist}/pclg-tools.jar:
        "/>

    <!--    Tests-->
    <property name="tests_dir" value="${module_pclg_agenda}/src/test"/>
    <property name="build_tests" location="${basedir}/../../build-agenda_tests"/>
    <property name="test_resources" location="${module_pclg_agenda}/src/test/resources"/>
    <taskdef resource="testngtasks" classpath="${lib_dir}/testng-6.8.8.jar"/>
    <property name="build.test.results.dir" value="/tmp/test_results"/>

    <target name="_init">
        <tstamp/>
        <mkdir dir="${build}"/>
        <mkdir dir="${dist}"/>
        <mkdir dir="${build_tests}"/>

        <copy todir="${build}" preservelastmodified="true">
            <fileset dir="${resources}" includes="${properties}"/>
        </copy>

        <copy todir="${dist}" preservelastmodified="true">
            <fileset dir="${resources}" includes="${properties}"/>
        </copy>

        <copy file="${resources}/Agenda_technical-${local_config.host.name}.properties" tofile="${build}/Agenda_technical.properties" preservelastmodified="true"/>
        <copy file="${resources}/Agenda_technical-${local_config.host.name}.properties" tofile="${dist}/Agenda_technical.properties" preservelastmodified="true"/>
    </target>

    <target name="_compile" depends="_init" description="Compile the sources">
        <javac
                classpath="${classpath}"
                includeantruntime="false"
                srcdir="${src}"
                destdir="${build}"
                deprecation="on"
                debug="true"
                verbose="no"
                listfiles="yes"
                source="${local_config.jdk-version}"
                target="${local_config.jdk-version}"
                encoding="ISO-8859-1">
            <compilerarg value="-Xlint"/>
        </javac>
    </target>

    <target name="_compile_tests" depends="_compile"
            description="compile the tests ">
        <javac
                classpath="${classpath} : ${build}"
                includeantruntime="false"
                srcdir="${tests_dir}"
                destdir="${build_tests}"
                deprecation="on"
                debug="true"
                verbose="no"
                listfiles="yes"
                source="${local_config.jdk-version}"
                target="${local_config.jdk-version}"
                encoding="ISO-8859-1">
            <compilerarg value="-Xlint"/>
        </javac>
    </target>

    <target name="_tests" depends="_compile_tests">
        <testng failureProperty="test.failed" dumpCommand="true" outputdir="${build.test.results.dir}">
            <classpath>
                <path path="${test_resources} : ${classpath} : ${build} : ${dist}"/>
            </classpath>
            <classpath location="${build_tests}"/>
            <classpath location="${tests_dir}"/>

            <classfileset dir="${build_tests}" includes="**/*Test*.class"/>

        </testng>
        <fail message="Test failure detected, check test results." if="test.failed"/>
    </target>

    <target name="pclg-agenda_jar" depends="_compile">
        <jar destfile="${dist}/${pclg-agenda_jar_name}" basedir="${build}" excludes="**">
            <fileset dir="${build}" includes="**/*.class"/>
            <manifest>
                <attribute name="Built-By" value="${user.name}"/>
                <attribute name="Main-Class" value="org.pclg.agenda.Agenda"/>
                <attribute name="Class-Path" value=". : pclg-tools.jar : Icons.jar : Sounds.jar : toolbarButtonGraphics.jar : log4j-1.2.15.jar : derby.jar : javaee.jar : ez-vcard-0.9.5.jar"/>
            </manifest>
        </jar>
    </target>

    <target name="build" depends="_tests, pclg-agenda_jar"/>

     <target name="clean">
         <echo message="Cleaning ${ant.project.name}"/>
         <delete includeEmptyDirs="true">
             <fileset dir="${build}" includes="*/**"/>
         </delete>
    </target>
</project>