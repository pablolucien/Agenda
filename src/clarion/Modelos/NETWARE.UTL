!  Funciones agregadas al modelo
!  Estan en un include para ahorrar espacio

InitProc  procedure
helpfile  string(128)	  !!!PCLG
  code
    ctrlfile = getname()
    if ctrlfile = 'cpro.exe'
       show(10, 10, 'Using Default Control File', @s69)
       ask
    .
    helpfile = sub(ctrlfile,1,len(clip(ctrlfile))-3) & 'HLP'
    HELP(HELPFILE)		 !!!PCLG	 !OPEN THE HELP FILE

    ctrlfile = sub(ctrlfile,1,len(clip(ctrlfile))-3) & 'CNT'
    share(xxcontr)
    IF ERRORCODE() = 2				  !IF NOT FOUND,
      CREATE(xxcontr)                             !  THEN CREATE
      CLOSE(xxcontr)                              !  CLOSE IT SO IT CAN
      SHARE(xxcontr)                              !    BE OPENED SHARED
    .
    set(xxcontr)
    next(xxcontr)
    mem:empresa = xxc:empresa
    show(2,3,xxc:empresa,@S60)
    show(3,2,center(xxc:sistema,78),@S78)
    hora
    !idle(hora,0)
    idle(hora,60)
    Get_Pass(xxc:PassWord)
    oldpath = path()
    setpath(xxc:datadisk & ':' & xxc:datapath)     !¨Donde estan los datos?
    close(xxcontr)
    G_OPENFILES					 !OPEN OR CREATE FILES
    salir = 0

LastProc      procedure
  code
    setpath(oldpath)				   !Todo como estaba
    sethue(7,0)					   !Limpiar la pantalla
    blank

Get_Pass     Procedure(clave)
Clave	     String(10)	  !Password correcta
   ! Obtener PassWord

PassWord     String(10)	  !Password para el sistema
SCREEN	     Screen	  Window(1,26),At(13,28),Pre(SCR),Hue(10,0)
	       Row(1,1)	  Paint(1,16),Hue(0,2)
		 Col(15)  Entry,Use(?FIRST_FIELD)
		 Col(1)	  String('Enter Password:')
		 Col(17)  Entry(@S10),Use(PassWord),Hue(2,2),Ovr,Lft
		 Col(1)	  Entry,Use(?LAST_FIELD)
	     .

  EJECT
  CODE
  if clip(Clave) = '' then return.	  !No Hay password definida
  OPEN(SCREEN)
  SETCURSOR
  password = ''
  DISPLAY
  LOOP
    ALERT
    ALERT(ACCEPT_KEY)
    ALERT(REJECT_KEY)
    ACCEPT
    IF KEYCODE() = REJECT_KEY THEN stop('Incorect password').
    IF KEYCODE() = ACCEPT_KEY			 !ON SCREEN ACCEPT KEY
      UPDATE					 !  MOVE ALL FIELDS FROM SCREEN
      SELECT(?)					 !  START WITH CURRENT FIELD
      SELECT					 !  EDIT ALL FIELDS
      CYCLE					 !  GO TO TOP OF LOOP
    .						 !
    CASE FIELD()				 !JUMP TO FIELD EDIT ROUTINE
    OF ?FIRST_FIELD				 !FROM THE FIRST FIELD
      IF KEYCODE() = ESC_KEY THEN stop('Incorect password').
    OF ?LAST_FIELD				 !FROM THE LAST FIELD
      IF ACTION <> 3				 !IF THIS IS NOT A DELETE
	ACTION = 2				 !  SET ACTION TO CHANGE MODE
	If clip(PassWord) <> clip(Clave) then stop('Incorect password') else return.
	IF ACTION				 !  IF RECORD WAS NOT CHANGED
	  SELECT(?LAST_FIELD - 1)		 !    SELECT THE LAST ENTRY
	  CYCLE					 !    AND LOOP AGAIN
      . .
      ACTION = 0				 !  SET ACTION TO COMPLETE
      RETURN					 !  AND RETURN TO CALLER
  . .



ConfSalida	 procedure
Confirma     Screen	  Window(6,12),At(10,35),Pre(SCR),Hue(14,1)
	       Row(1,1)	  String('ÉÍ{10}»')
	       Row(2,1)	  String('º<0{10}>º')
	       Row(3,1)	  String('ÌÍ{10}¹')
	       Row(4,1)	  Repeat(2);String('º<0>³<0{8}>º') .
	       Row(6,1)	  String('ÈÍ{10}¼')
	       Row(2,4)	  String('Salida')
		 Col(2)	  Entry,Use(?primer_campo)
		 Col(2)	  Entry,Use(?pre_menu)
		 Col(2)	  Menu,Use(MENU_FIELD"),Req
	       Row(4,4)	    String('Si {6}'),Sel(0,7)
	       Row(5,4)	    String('No {6}'),Sel(0,7)
	     .		  .

  code
  open(Confirma)
  SETCURSOR					 !TURN OFF ANY CURSOR
  MENU_FIELD" = ''				 !START MENU WITH FIRST ITEM
  LOOP						 !LOOP UNTIL USER EXITS
    ALERT					 !TURN OFF ALL ALERTED KEYS
    ALERT(REJECT_KEY)				 !ALERT SCREEN REJECT KEY
    ALERT(ACCEPT_KEY)				 !ALERT SCREEN ACCEPT KEY
    ACCEPT					 !READ A FIELD OR MENU CHOICE
    IF KEYCODE() = REJECT_KEY THEN RETURN.	 !RETURN ON SCREEN REJECT

    IF KEYCODE() = ACCEPT_KEY			 !ON SCREEN ACCEPT KEY
      UPDATE					 !  MOVE ALL FIELDS FROM SCREEN
      SELECT(?)					 !  START WITH CURRENT FIELD
      SELECT					 !  EDIT ALL FIELDS
      CYCLE					 !  GO TO TOP OF LOOP
    .						 !

    CASE FIELD()				 !JUMP TO FIELD EDIT ROUTINE
    OF ?primer_campo				 !FROM THE FIRST FIELD
      IF KEYCODE() = ESC_KEY THEN return.	 !RETURN ON ESC KEY

    OF ?pre_menu				 !PRE MENU FIELD CONDITION
      IF KEYCODE() = ESC_KEY			 !  BACKING UP?
	SELECT(?-1)				 !    SELECT PREVIOUS FIELD
      ELSE					 !  GOING FORWARD
	SELECT(?+1)				 !    SELECT MENU FIELD
      .
    OF ?MENU_FIELD"				 !FROM THE MENU FIELD
      EXECUTE CHOICE()				 !  CALL THE SELECTED PROCEDURE
	restart(Salida)
	salir = 0				!
      .
      return
    .
  .

Salida	procedure
 code
   salir = 1
   setpath(oldpath)  !Todo como estaba
   sethue(7,0)	     !Limpiar la pantalla
   blank
   return	     !EXIT TO DOS

hora	     procedure				 ! Fecha y Hora
  code
    sethue(1,3)
!    show(2,58,day(today())&' '&nombre_mes[month(today())]&' '&year(today()),@s11)
!    show(2,71,clock(),@t4)
    show(2,62,day(today())&' '&nombre_mes[month(today())]&' '&year(today()),@s11)
    show(2,74,clock(),@t1)
    show(3,69,memory(),@n10)
    sethue

xxcontr      PROCEDURE

SCREEN	     Screen	  Window(7,75),At(9,3),Pre(SCR),Hue(15,4)
	       Row(1,1)	  String('ÉÍ{73}»')
	       Row(2,1)	  Repeat(3),Every(2);String('º<0{73}>º') .
	       Row(3,1)	  String('ÌÍ{73}¹')
	       Row(5,1)	  String('º<0{73}>º')
	       Row(7,1)	  String('ÈÍ{73}¼')
	       Row(2,31)  String('Datos de control')
	       Row(3,54)  Entry,Use(?FIRST_FIELD)
	       Row(4,3)	  String('Disco de Datos:')
                 Col(18)  Entry(@S1),Use(xxc:DATADISK),Lft
	       Row(5,3)	  String('Directorio:')
                 Col(14)  Entry(@S60),Use(xxc:DATAPATH),Lft
	       Row(6,3)	  String('PassWord:')
                 Col(12)  Entry(@S10),Use(xxc:PassWord),Lft
	       Row(7,73)  Entry,Use(?LAST_FIELD)
		 Col(73)  Pause(''),Use(?DELETE_FIELD)
	     .
TABLE	     TABLE,PRE(SAV)
SAVE_RECORD    GROUP;BYTE,DIM(SIZE(xxc:RECORD)).
	     .

  EJECT
  CODE
  get(xxcontr, 1)
  OPEN(SCREEN)					 !OPEN THE SCREEN
  SETCURSOR					 !TURN OFF ANY CURSOR
  SAVE_RECORD = xxc:RECORD                       !SAVE THE ORIGINAL
  ADD(TABLE,1)					 !STORE IN MEMORY TABLE
  IF ACTION = 5					 !AUTONUMBER ACTION
    DISK_ACTN# = 2				 !  SET FOR PHYSICAL ACTION
    ACTION = 1					 !  SET FOR LOGICAL ACTION
  ELSE						 !OTHERWISE
    DISK_ACTN# = ACTION				 !  SET ACTION FOR DISK WRITE
  .
  DISPLAY					 !DISPLAY THE FIELDS

  EXECUTE DISK_ACTN#				 !SET THE CURRENT RECORD POINTER
    POINTER# = 0				 !  NO RECORD FOR ADD
    POINTER# = POINTER(xxcontr)                  !  CURRENT RECORD FOR CHANGE
    POINTER# = POINTER(xxcontr)                  !  CURRENT RECORD FOR CHANGE
  .
  ACTION# = ACTION				 !STORE REQUIRED ACTION
  LOOP						 !LOOP THRU ALL THE FIELDS
    MEM:MESSAGE = CENTER(MEM:MESSAGE,SIZE(MEM:MESSAGE)) !DISPLAY ACTION MESSAGE
    DO CALCFIELDS				 !CALCULATE DISPLAY FIELDS
    ALERT					 !RESET ALERTED KEYS
    ALERT(ACCEPT_KEY)				 !ALERT SCREEN ACCEPT KEY
    ALERT(REJECT_KEY)				 !ALERT SCREEN REJECT KEY
    ACCEPT					 !READ A FIELD
    IF KEYCODE() = REJECT_KEY THEN BREAK.	 !RETURN ON SCREEN REJECT KEY
    EXECUTE ACTION				 !SET MESSAGE
      MEM:MESSAGE = 'Se agregar  el registro'	 !
      MEM:MESSAGE = 'Se modificar  el registro'	 !
      MEM:MESSAGE = 'Se borrar  el registro'	 !
    .
    IF KEYCODE() = ACCEPT_KEY			 !ON SCREEN ACCEPT KEY
      UPDATE					 !  MOVE ALL FIELDS FROM SCREEN
      SELECT(?)					 !  START WITH CURRENT FIELD
      SELECT					 !  EDIT ALL FIELDS
      CYCLE					 !  GO TO TOP OF LOOP
    .
    CASE FIELD()				 !JUMP TO FIELD EDIT ROUTINE
    OF ?FIRST_FIELD				 !FROM THE FIRST FIELD
      IF KEYCODE() = ESC_KEY THEN BREAK.	 !  RETURN ON ESC KEY
      IF ACTION = 3 THEN SELECT(?DELETE_FIELD).!    OR CONFIRM FOR DELETE

    OF ?LAST_FIELD				 !FROM THE LAST FIELD
      IF ACTION = 2 OR ACTION = 3		 !IF UPDATING RECORD
        SAVE_RECORD = xxc:RECORD                 !  SAVE CURRENT CHANGES
	ADD(TABLE,2)				 !  STORE IN MEMORY TABLE
	GET(TABLE,1)				 !  RETRIEVE ORIGINAL RECORD
        HOLD(xxcontr)                            !  HOLD FILE
        GET(xxcontr,POINTER#)                    !  RE-READ SAME RECORD
	IF ERRORCODE() = 35			 !  IF RECORD WAS DELETED
	  IF DISK_ACTN# = 2			 !  IF TRYING TO UPDATE
	     DISK_ACTN# = 1			 !    THEN ADD IT BACK
	  ELSE					 !
             RELEASE(xxcontr)                    !  RELEASE FILE
	     ACTION = 0				 !  TURN OFF ACTION
	  .
	ELSIF |					 !OTHERWISE
          xxc:RECORD <> SAVE_RECORD              !    BY ANOTHER STATION
	  MEM:MESSAGE = 'Cambiado por otra estaci¢n' !INFORM USER
	  SELECT(2)				 !  GO BACK TO TOP OF FORM
	  BEEP					 !  SOUND ALARM
          RELEASE(xxcontr)                       !  RELEASE FILE
          SAVE_RECORD = xxc:RECORD               !  SAVE RECORD
	  DISPLAY				 !  DISPLAY THE FIELDS
	  PUT(TABLE)				 !  FREE SAVED CHANGES
	  CYCLE					 !  AND CONTINUE
	.
	GET(TABLE,2)				 !  READ CURRENT (CHANGED) REC
        xxc:RECORD = SAVE_RECORD                 !  MOVE RECORD
	DELETE(TABLE)				 !  DELETE MEMORY TABLE ITEM
      .
      EXECUTE DISK_ACTN#			 !  UPDATE THE FILE
        ADD(xxcontr)                             !    ADD NEW RECORD
        PUT(xxcontr)                             !    CHANGE EXISTING RECORD
        DELETE(xxcontr)                          !    DELETE EXISTING RECORD
      .
      IF ERRORCODE() = 40			 !  DUPLICATE KEY ERROR
	MEM:MESSAGE = ERROR()			 !    DISPLAY ERR MESSAGE
	SELECT(2)				 !    POSITION TO TOP OF FORM
        IF ACTION = 2 THEN RELEASE(xxcontr). !        RELEASE HELD RECORD
	CYCLE					 !    GET OUT OF EDIT LOOP
      ELSIF ERROR()				 !  CHECK FOR UNEXPECTED ERROR
	STOP(ERROR())				 !    HALT EXECUTION
      .
      IF ACTION = 1 THEN POINTER# = POINTER(xxcontr). !POINT TO RECORD
      SAVE_RECORD = xxc:RECORD                   !  NEW ORIGINAL
      ACTION = ACTION#				 !  RETRIEVE ORIGINAL OPERATION
      ACTION = 0				 !  SET ACTION TO COMPLETE
      BREAK					 !  AND RETURN TO CALLER

    OF ?DELETE_FIELD				 !FROM THE DELETE FIELD
      IF KEYCODE() = ENTER_KEY |		 !  ON ENTER KEY
      OR KEYCODE() = ACCEPT_KEY			 !  OR CTRL-ENTER KEY
	SELECT(?LAST_FIELD)			 !    DELETE THE RECORD
      ELSE					 !  OTHERWISE
	BEEP					 !    BEEP AND ASK AGAIN
  . . .
  FREE(TABLE)					 !  RELEASE MEMORY TABLE
  put(xxcontr)
  RETURN					 !  AND RETURN TO CALLER

CALCFIELDS   ROUTINE
  IF FIELD() > ?FIRST_FIELD			 !BEYOND FIRST_FIELD?
    IF KEYCODE() = 0 AND SELECTED() > FIELD() THEN EXIT. !GET OUT IF NOT NONSTOP
  .


Calendario   PROCEDURE
CALENDAR     Screen	  Window(19,29),At(5,8),Pre(CAL),Hue(7,1,0)
	       Row(1,1)	  String('ÉÍ{27}»')
	       Row(2,1)	  Repeat(2),Every(16);String('º<0{27}>º') .
	       Row(3,1)	  String('ºÍÍÍÑÍÍÍÑÍÍÍÑÍÍÍÑÍÍÍÑÍÍÍÑÍÍÍ¹')
	       Row(4,1)	  Repeat(7),Every(2)
			    String('º<0{3}>³<0{3}>³<0{3}>³<0{3}>³<0{3}>³<0{3}>³<0{3}>º') .
	       Row(5,1)	  Repeat(3),Every(4);String('ºÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄ¶') .
	       Row(7,1)	  String('ºÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄº')
	       Row(11,1)  Repeat(2),Every(4);String('ºÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄÅÄÄÄ¶') .
	       Row(17,1)  String('ÌÍÍÍÏÍÍÍÏÍÍÍÏÍÍÍÏÍÍÍÏÍÍÍÏÍÍÍ¹')
	       Row(19,1)  String('ÈÍ{27}¼')
	       Row(4,2)	  String('Dom'),Enh
		 Col(6)	  String('Lun'),Enh
		 Col(10)  String('Mar'),Enh
		 Col(14)  String('Mie'),Enh
		 Col(18)  String('Jue'),Enh
		 Col(22)  String('Vie'),Enh
		 Col(26)  String('Sab'),Enh
	       Row(18,4)  String('PgUp PgDn ^PgUp ^PgDn'),Enh
Mes_Ano	       Row(2,8)	  String(15),Enh
			  Repeat(15),Index(INDEX)
			  .
			  Repeat(6,7),Every(2,4),Index(INDEX)
	       Row(6,2)	    Point(1,3),Use(?INDEX),Hlp('CALENDAR'),Req
DAY		 Col(2)	    String(@N_2B)
	     .		  .

DATE	     LONG				 !SELECTED DATE
MONTH	     LONG				 !SELECTED MONTH
DAY	     LONG				 !SELECTED DAY
YEAR	     LONG				 !SELECTED YEAR
 !MONTH_YEAR STRING(14)				 !SELECTED MONTH AND YEAR

MONTH_NAMES  GROUP				 !NAMES OF THE MONTHS
	       STRING('Enero     Febrero   Marzo     Abril     ')
	       STRING('Mayo      Junio     Julio     Agosto    ')
	       STRING('SeptiembreOctubre   Noviembre Diciembre ')
	     .
MONTH_NAME   STRING(10),DIM(12),OVER(MONTH_NAMES) !ARRAY OF MONTH NAMES

TRNSFORM_TBL GROUP				 !THIS TABLE TRANSFORMS
	       STRING('<01,07,13,19,25,31,37>')	 !  COLUMN WITHIN ROW
	       STRING('<02,08,14,20,26,32,38>')	 !    SEQUENCE
	       STRING('<03,09,15,21,27,33,39>')	 !	INTO
	       STRING('<04,10,16,22,28,34,40>')	 !  ROW WITHIN COLUMN
	       STRING('<05,11,17,23,29,35,41>')	 !    SEQUENCE
	       STRING('<06,12,18,24,30,36,42>')	 !
	     .					 !
TRANSFORM    BYTE,DIM(42)OVER(TRNSFORM_TBL)	 !REDECLARE AS A BYTE ARRAY

INDEX	     BYTE				 !REPEAT INDEX
SAVE_INDEX   BYTE				 !SAVE AREA FOR REPEAT INDEX
BASE_COL     LONG				 !LAST COLUMN OF LAST MONTH
BASE_DATE    LONG				 !LAST DAY OF LAST MONTH
I	     BYTE				 !SUBSCRIPT USED FOR DAY
LAST_DAY     BYTE				 !LAST CALENDAR DAY OF MONTH

  CODE
  DATE = TODAY()				 !SELECT TODAY'S DATE
  MONTH = MONTH(DATE)				 !SELECT TODAY'S MONTH
  DAY = DAY(DATE)				 !SELECT TODAY'S DAY
  YEAR = YEAR(DATE)				 !SELECT TODAY'S YEAR
  INDEX = TRANSFORM[(DATE-DAY+1) % 7 + DAY]	 !SET REPEAT INDEX
  OPEN(CALENDAR)				 !SHOW THE CALENDAR
  LOOP						 !LOOP UNTIL CTRL-ESC KEY
    SAVE_INDEX = INDEX				 !SAVE REPEAT INDEX
    cal:mes_ano = CLIP(MONTH_NAME[MONTH])&' '&YEAR!SET MONTH AND YEAR
 !  MONTH_YEAR = CLIP(MONTH_NAME[MONTH])&' '&YEAR!SET MONTH AND YEAR
 !  LOOP INDEX = 1 TO 15			 !SHOW THE MONTH AND YEAR
 !    CAL:MONTH_YEAR = SUB(MONTH_YEAR,INDEX,1)	 !
 !  .
    BASE_DATE = DATE(MONTH,1,YEAR) - 1		 !SET BASE DATE
    BASE_COL = (BASE_DATE + 1) % 7		 !SET BASE COLUMN
    LAST_DAY = DAY(DATE(MONTH+1,1,YEAR) -1)	 !GET LAST DAY OF MONTH
    LOOP I = 1 TO BASE_COL			 !CLEAR LEADING UNUSED BOXES
      INDEX = TRANSFORM[I]			 !  FOR THE MONTH DISPLAYED
      CAL:DAY = ''				 ! CLEAR SCREEN VARIABLE
    .
    LOOP I = (LAST_DAY + BASE_COL + 1) TO (42)	 !CLEAR TRAILING UNUSED BOXES
      INDEX = TRANSFORM[I]			 !  FOR THE MONTH DISPLAYED
      CAL:DAY = ''				 ! CLEAR SCREEN VARIABLE
    .
    LOOP I = 1 TO LAST_DAY			 !LOOP FOR EACH DAY OF MONTH
      INDEX = TRANSFORM[I + BASE_COL]		 !SET REPEAT INDEX TO TODAY
      CAL:DAY = I				 !SHOW THE DAY OF THE MONTH
      IF ~ERROR()				 !IF THERE IS A RECORD
    . .
    INDEX = SAVE_INDEX				 !RESTORE REPEAT INDEX
    LOOP
      ALERT					 !CLEAR ALL ALERT KEYS
      ALERT(CTRL_HOME)				 !CTRL-HOME RESETS CALENDAR
      ALERT(CTRL_ESC)				 !CTRL-ESC TERMINATES CALENDAR
      ALERT(ESC_key)				 !ESC TERMINATES CALENDAR
      ACCEPT					 !GET AN ALERTED KEY STROKE
      CASE KEYCODE()				 !JUMP TO THE KEYSTROKE
      OF ENTER_KEY				 !DAY WAS SELECTED
      OF CTRL_ESC				 !RETURN ON Ctrl-Esc KEY
      of esc_key
	return
      OF PGUP_KEY				 !LAST MONTH ON PgUp kEY
	MONTH-=1
      OF PGDN_KEY				 !NEXT MONTH ON PgDn KEY
	MONTH+=1
      OF CTRL_PGUP				 !LAST YEAR ON Ctrl-PgUp KEY
	YEAR-=1
      OF CTRL_PGDN				 !NEXT YEAR ON Ctrl-PgDn KEY
	YEAR+=1
      OF CTRL_HOME				 !TODAY ON Ctrl-Home KEY
	DATE = TODAY()				 !SELECT TODAY'S DATE
	MONTH = MONTH(DATE)			 !SELECT TODAY'S MONTH
	DAY = DAY(DATE)				 !SELECT TODAY'S DAY
	YEAR = YEAR(DATE)			 !SELECT TODAY'S YEAR
	INDEX = TRANSFORM[(DATE-DAY+1) % 7 + DAY]!SET REPEAT INDEX TO TODAY
      .
      IF MONTH < 1 THEN YEAR-=1;MONTH=12.	 !CORRECT MONTH UNDERFLOW
      IF MONTH > 12 THEN YEAR+=1;MONTH=1.	 !CORRECT MONTH OVERFLOW
      BREAK					 !REDISPLAY THE CALANDER
  . .


Sin_Hacer    Procedure
SCREEN	     Screen	  Window(1,80),At(25,1),Hue(31,4)
	       Row(1,34)  String('¢<0{8}> ')
		 Col(24)  String('Esta funci')
		 Col(35)  String('n no est')
		 Col(45)  String('disponible')
	     .
  Code
    Open(Screen)
    Beep(120,50)
    ask



Capitalize   Procedure(xNombre)
xNombre external
s  string(255)
kk string(1), dim(255), over(s)
l byte
i byte
  code
  s = xNombre
  l = len(s)
  kk[1] = upper(kk[1])
  loop i = 2 to l
     if(kk[i - 1] = ' ' OR kk[i - 1] = '.' OR kk[i - 1] = ',' OR kk[i - 1] = '(' OR kk[i - 1] = ')') then
	kk[i] = upper(kk[i])
     else
	kk[i] = lower(kk[i])
     .
  .
  xNombre = s
  display
