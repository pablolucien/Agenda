                 COL(13)  ENTRY(@S3),USE(MO7),REQ,LFT
                 COL(27)  ENTRY(@S12),USE(MONTH7),REQ,LFT
               ROW(13,10) STRING('8:'),HUE(12,0)
                 COL(13)  ENTRY(@S3),USE(MO8),REQ,LFT
                 COL(27)  ENTRY(@S12),USE(MONTH8),REQ,LFT
               ROW(14,10) STRING('9:'),HUE(12,0)
                 COL(13)  ENTRY(@S3),USE(MO9),REQ,LFT
                 COL(27)  ENTRY(@S12),USE(MONTH9),REQ,LFT
               ROW(15,9)  STRING('10:'),HUE(12,0)
