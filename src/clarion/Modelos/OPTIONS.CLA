                 COL(13)  ENTRY(@S3),USE(MO12),REQ,LFT
                 COL(27)  ENTRY(@S12),USE(MONTH12),REQ,LFT
             .

  CODE
  OPEN(SCREEN)                                   !OPEN THE SCREEN
  DISPLAY
  LOOP                                           !LOOP THRU ALL THE FIELDS
    ACCEPT                                       !READ A FIELD
      CASE FIELD()                               !JUMP TO FIELD EDIT ROUTINE
      OF ?FIRST
        IF KEYCODE() = ESC_KEY THEN RETURN.
      OF ?MONTH12
        RETURN                                   !  AND RETURN TO CALLER
  . .

MESSAGES     PROCEDURE

Screen       Screen       Window(25,80),Pre(Scr),Hue(7,0),Hlp('CRITERR')
               Row(1,1)   String('…Õ{78}ª')
               Row(2,1)   Repeat(3),Every(2);String('∫<0{78}>∫') .
               Row(3,1)   Repeat(2),Every(5);String('«ƒ{78}∂') .
               Row(5,1)   Repeat(2),Every(2);String('∫<0{78}>∫') .
               Row(9,1)   Repeat(11);String('∫<0{78}>∫') .
               Row(20,1)  String('«ƒ{78}∂')
               Row(21,1)  Repeat(4);String('∫<0{78}>∫') .
               Row(25,1)  String('»Õ{78}º')
               Row(2,30)  String('CRITICAL ERROR MESSAGES'),Hue(12,0)
               Row(6,20)  String('READ'),Hue(12,0)
               Row(2,2)   Entry,Use(?First)
               Row(4,18)  String('ACTION :'),Hue(12,0)
                 Col(26)  Entry(@S7),Use(OPT:action),Req,Lft
               Row(5,18)  String('DURING :'),Hue(12,0)
                 Col(26)  Entry(@S10),Use(OPT:during1),Req,Lft
               Row(6,25)  String(':'),Hue(12,0)
                 Col(26)  Entry(@S10),Use(OPT:read_error),Req,Lft
               Row(7,19)  String('WRITE :'),Hue(12,0)
                 Col(26)  Entry(@S10),Use(OPT:wrt_error),Req,Lft
               Row(9,11)  String('ERROR ON DISK :'),Hue(12,0)
                 Col(26)  Entry(@S24),Use(OPT:disk_error),Req,Lft
               Row(10,16) String('ERROR ON :'),Hue(12,0)
                 Col(26)  Entry(@S39),Use(OPT:error_on),Req,Lft
               Row(11,4)  String('PRINTER OUT OF PAPER :'),Hue(12,0)
                 Col(26)  Entry(@S49),Use(OPT:no_paper),Req,Lft
               Row(12,8)  String('PRINTER OFF-LINE :'),Hue(12,0)
                 Col(26)  Entry(@S49),Use(OPT:prt_off),Req,Lft
               Row(13,9)  String('GENERAL FAILURE :'),Hue(12,0)
                 Col(26)  Entry(@S49),Use(OPT:general),Req,Lft
               Row(14,3)  String('FILE ALLOCATION TABLE :'),Hue(12,0)
                 Col(26)  Entry(@S49),Use(OPT:fat_bad),Req,Lft
               Row(15,4)  String('MEMORY IMAGE CORRUPT :'),Hue(12,0)
                 Col(26)  Entry(@S49),Use(OPT:mem_corr),Req,Lft
               Row(16,4)  String('WRITE PROTECTED DISK :'),Hue(12,0)
                 Col(26)  Entry(@S49),Use(OPT:writ_prot),Req,Lft
               Row(17,8)  String('DEVICE NOT READY :'),Hue(12,0)
                 Col(26)  Entry(@S49),Use(OPT:dev_not_rd),Req,Lft
               Row(18,10) String('CRC DATA ERROR :'),Hue(12,0)
                 Col(26)  Entry(@S49),Use(OPT:crc_error),Req,Lft
               Row(19,8)  String('SECTOR NOT FOUND :'),Hue(12,0)
                 Col(26)  Entry(@S49),Use(OPT:sector_lst),Req,Lft
               Row(21,7)  String('ABORT :'),Hue(12,0)
                 Col(14)  Entry(@S35),Use(OPT:abort),Req,Lft
                 Col(52)  String('KEY:'),Hue(12,0)
                 Col(56)  Entry(@S1),Use(OPT:abortkey),Req,Lft
               Row(22,7)  String('RETRY :'),Hue(12,0)
                 Col(14)  Entry(@S35),Use(OPT:retry),Req,Lft
                 Col(52)  String('KEY:'),Hue(12,0)
                 Col(56)  Entry(@S1),Use(OPT:retrykey),Req,Lft
               Row(23,6)  String('IGNORE :'),Hue(12,0)
                 Col(14)  Entry(@S35),Use(OPT:ignore),Req,Lft
                 Col(52)  String('KEY:'),Hue(12,0)
                 Col(56)  Entry(@S1),Use(OPT:ignorekey),Req,Lft
               Row(24,8)  String('FAIL :'),Hue(12,0)
                 Col(14)  Entry(@S35),Use(OPT:fail),Req,Lft
                 Col(52)  String('KEY:'),Hue(12,0)
                 Col(56)  Entry(@S1),Use(OPT:failkey),Req,Lft
             .

  CODE
  OPEN(SCREEN)                                   !OPEN THE SCREEN
  DISPLAY
  LOOP                                           !LOOP THRU ALL THE FIELDS
    ACCEPT                                       !READ A FIELD
    CASE FIELD()
    OF ?FIRST
      IF KEYCODE() = ESC_KEY THEN RETURN.
    OF ?OPT:FAILKEY                              !JUMP TO FIELD EDIT ROUTINE
      RETURN                                     !  AND RETURN TO CALLER
  . .

HMESSAGES    PROCEDURE

SCREEN       SCREEN       WINDOW(11,80),PRE(SCR),HUE(7,0),HLP('MESSAGES')
               ROW(1,1)   STRING('<201,205{78},187>')
               ROW(2,1)   STRING('<186,0{78},186>')
               ROW(3,1)   STRING('<199,196{78},182>')
               ROW(4,1)   REPEAT(7);STRING('<186,0{78},186>') .
               ROW(11,1)  STRING('<200,205{78},188>')
               ROW(2,32)  STRING('HELP ERROR MESSAGES'),HUE(12,0)
                 COL(2)   ENTRY,USE(?FIRST)
               ROW(5,19)  STRING('NO HELP IS AVAILABLE:'),HUE(12,0)
                 COL(40)  ENTRY(@S20),USE(OPT:NOHELPAVL),REQ,LFT
               ROW(7,4)   STRING('NO HELP FOR THIS TOPIC CAN BE FOUND:'),HUE(12,0)
                 COL(40)  ENTRY(@S35),USE(OPT:TOPNOTFND),REQ,LFT
               ROW(9,14)  STRING('HELP FILE CANNOT BE FOUND:'),HUE(12,0)
                 COL(40)  ENTRY(@S25),USE(OPT:HELPNOTFND),REQ,LFT
             .

  CODE
  OPEN(SCREEN)                                   !OPEN THE SCREEN
  DISPLAY
  LOOP                                           !LOOP THRU ALL THE FIELDS
    ACCEPT                                       !READ A FIELD
    CASE FIELD()
    OF ?FIRST
      IF KEYCODE() = ESC_KEY THEN RETURN.
    OF ?OPT:HELPNOTFND                           !JUMP TO FIELD EDIT ROUTINE
      RETURN                                     !  AND RETURN TO CALLER
  . .

INIT  PROCEDURE
      CODE
      CLEAR(OPT:RECORD)
      OPT:SIGNATURE = ISFSIG
      LOOP I# = 1 TO 256
         CO[I#] = I#-1
      .
      OPT:UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
      OPT:LOWER = 'abcdefghijklmnopqrstuvwxyz'
      MO[1] = 'JAN'
      MO[2] = 'FEB'
      MO[3] = 'MAR'
      MO[4] = 'APR'
      MO[5] = 'MAY'
      MO[6] = 'JUN'
      MO[7] = 'JUL'
      MO[8] = 'AUG'
      MO[9] = 'SEP'
      MO[10] = 'OCT'
      MO[11] = 'NOV'
      MO[12] = 'DEC'
      MONTH[1] = 'January'
      MONTH[2] = 'February'
      MONTH[3] = 'March'
      MONTH[4] = 'April'
      MONTH[5] = 'May'
      MONTH[6] = 'June'
      MONTH[7] = 'July'
      MONTH[8] = 'August'
      MONTH[9] = 'September'
      MONTH[10] = 'October'
      MONTH[11] = 'November'
      MONTH[12] = 'December'
      OPT:GENERAL = 'General failure'
      OPT:ACTION = 'Action:'
      OPT:DISK_ERROR = 'Error on disk'
      OPT:DURING1 = 'during'
      OPT:READ_ERROR = 'read'
      OPT:WRT_ERROR = 'write'
      OPT:PRT_OFF = 'Printer off-line'
      OPT:ERROR_ON = 'Error on'
      OPT:FAT_BAD = 'File Allocation Table'
      OPT:MEM_CORR = 'Memory image corrupt'
      OPT:WRIT_PROT = 'Write to write-protected disk'
      OPT:DEV_NOT_RD = 'Device not ready'
      OPT:CRC_ERROR = 'Crc data error'
      OPT:SECTOR_LST = 'Sector not found'
      OPT:NO_PAPER = 'Printer out of paper'
      OPT:ABORT = '(A)bort  - End this program!'
      OPT:IGNORE = '(I)gnore - Error is not important'
      OPT:RETRY = '(R)etry  - After correcting error'
      OPT:FAIL = '(F)ail   - Return error to program'
      OPT:ABORTKEY = 'A'
      OPT:RETRYKEY = 'R'
      OPT:IGNOREKEY = 'I'
      OPT:FAILKEY = 'F'
      OPT:NOHELPAVL = 'No help is available'
      OPT:HELPNOTFND = 'Help file cannot be found'
      OPT:TOPNOTFND = 'No help for this topic can be found'
      OPT:LIBAM = 'AM'
      OPT:LIBPM = 'PM'

REDOCOLLATE PROCEDURE
    CODE
    LOOP I# = 1 TO 256
      COX[CO[I#]+1] = I#-1
    .
    OPT:COLLATE = COLLATEX

GETNAME PROCEDURE
Getscr       Screen       Window(7,66),At(9,8),Hue(7,1,0),HLP('GETNAME')
               Row(1,1)   String('…Õ{64}ª')
               Row(2,1)   Repeat(5);String('∫<0{64}>∫') .
               Row(7,1)   String('»Õ{64}º')
               Row(3,11)  String('Please enter the name of the sort control file')
               Row(5,3)   String('Name:')
                 Col(8)   Entry(@s57),Use(OPTname),Lft
             .

    CODE

    OPEN(GETSCR)
    DISPLAY
    LOOP
      ACCEPT
      CASE FIELD()
      OF ?OPTNAME
        RETURN
      .
    .

DOANOTHER FUNCTION
ANOTHSCR     SCREEN       WINDOW(5,59),AT(10,12),HUE(7,1,0),HLP('ANOTHER')
               ROW(1,1)   STRING('…Õ{57}ª')
               ROW(2,1)   REPEAT(3);STRING('∫<0{57}>∫') .
               ROW(5,1)   STRING('»Õ{57}º')
               ROW(3,4)   STRING('Do you want to edit another options file?')
                 COL(46)  MENU(@S3),USE(YESNO),REQ
                 COL(51)    STRING('Yes')
                 COL(55)    STRING('No')
             .            .

YESNO STRING(3)
    CODE

    OPEN(ANOTHSCR)
    YESNO = 'No'
    LOOP
      ACCEPT
      CASE FIELD()
      OF ?YESNO
        EXECUTE CHOICE()
          RETURN(1)
          RETURN(0)
        .
      .
    .

MAKECSTR PROCEDURE
    CODE
    OPT:UPPER = CLIP(OPT:UPPER)&'<0>'
    OPT:LOWER = CLIP(OPT:LOWER)&'<0>'
    OPT:ACTION = CLIP(OPT:ACTION)&'<0>'
    OPT:READ_ERROR = CLIP(OPT:READ_ERROR)&'<0>'
    OPT:WRT_ERROR = CLIP(OPT:WRT_ERROR)&'<0>'
    OPT:GENERAL = CLIP(OPT:GENERAL)&'<0>'
    OPT:PRT_OFF = CLIP(OPT:PRT_OFF)&'<0>'
    OPT:FAT_BAD = CLIP(OPT:FAT_BAD)&'<0>'
    OPT:MEM_CORR = CLIP(OPT:MEM_CORR)&'<0>'
    OPT:WRIT_PROT = CLIP(OPT:WRIT_PROT)&'<0>'
    OPT:DEV_NOT_RD = CLIP(OPT:DEV_NOT_RD)&'<0>'
    OPT:CRC_ERROR = CLIP(OPT:CRC_ERROR)&'<0>'
    OPT:SECTOR_LST = CLIP(OPT:SECTOR_LST)&'<0>'
    OPT:NO_PAPER = CLIP(OPT:NO_PAPER)&'<0>'
    OPT:ABORT = CLIP(OPT:ABORT)&'<0>'
    OPT:IGNORE = CLIP(OPT:IGNORE)&'<0>'
    OPT:RETRY = CLIP(OPT:RETRY)&'<0>'
    OPT:FAIL = CLIP(OPT:FAIL)&'<0>'
    OPT:NOHELPAVL = CLIP(OPT:NOHELPAVL)&'<0>'
    OPT:HELPNOTFND = CLIP(OPT:HELPNOTFND)&'<0>'
    OPT:TOPNOTFND = CLIP(OPT:TOPNOTFND)&'<0>'

    !THESE NEED TRAILING BLANK THEN NULL
    OPT:DURING1_G = CLIP(OPT:DURING1)&' <0>'
    OPT:DISK_ERROR_G = CLIP(OPT:DISK_ERROR)&' <0>'
    OPT:ERROR_ON_G = CLIP(OPT:ERROR_ON)&' <0>'

    !LOOP THRU THE ARRAYS
    LOOP I# = 1 TO 12
      OPT:MONTH[I#] = CLIP(OPT:MONTH[I#])&'<0>'
    .

TIMEAMPM PROCEDURE
TIMSCR       SCREEN       WINDOW(8,24),HUE(7,1),HLP('TIME')
               ROW(1,1)   STRING('<201,205{22},187>')
               ROW(2,1)   REPEAT(6);STRING('<186,0{22},186>') .
               ROW(8,1)   STRING('<200,205{22},188>')
               ROW(2,3)   STRING('TIME AM/PM INDICATOR')
                 COL(5)   ENTRY,USE(?FIRSTFLD)
               ROW(4,10)  STRING('AM:')
                 COL(13)  ENTRY(@S2),USE(OPT:LIBAM),HUE(7,1),SEL(0,7),REQ,LFT
               ROW(6,10)  STRING('PM:')
                 COL(13)  ENTRY(@S2),USE(OPT:LIBPM),HUE(7,1),SEL(0,7),REQ,LFT
             .
    CODE

    OPEN(TIMSCR)
    DISPLAY
    LOOP
      ACCEPT
      CASE FIELD()
      OF ?FIRSTFLD
        IF KEYCODE() = ESC_KEY THEN RETURN.
      OF ?OPT:LIBPM
        RETURN
      .
    .
