               ROW(6,6)   PAINT(1,1),HUE(10,0)
               ROW(6,30)  PAINT(1,1),HUE(10,0)
               ROW(1,1)   STRING('<201,205{38},187>')
               ROW(2,1)   REPEAT(17);STRING('<186,0{38},186>') .
               ROW(19,1)  STRING('<200,205{38},188>')
               ROW(2,7)   STRING('MONTH NAMES AND ABBREVIATIONS'),HUE(12,0)
               ROW(4,10)  STRING('ABBREVIATIONS'),HUE(12,0)
                 COL(27)  STRING('FULL NAME'),HUE(12,0)
               ROW(6,4)   STRING('MO'),HUE(12,0)
                 COL(6)   STRING('N'),HUE(12,0)
               ROW(1,1)   ENTRY,USE(?FIRST)
               ROW(6,7)   STRING('TH 1:'),HUE(12,0)
                 COL(13)  ENTRY(@S3),USE(MO1),REQ,LFT
                 COL(27)  ENTRY(@S12),USE(MONTH1),REQ,LFT
               ROW(7,10)  STRING('2:'),HUE(12,0)
                 COL(13)  ENTRY(@S3),USE(MO2),REQ,LFT
                 COL(27)  ENTRY(@S12),USE(MONTH2),REQ,LFT
               ROW(8,10)  STRING('3:'),HUE(12,0)
                 COL(13)  ENTRY(@S3),USE(MO3),REQ,LFT
                 COL(27)  ENTRY(@S12),USE(MONTH3),REQ,LFT
               ROW(9,10)  STRING('4:'),HUE(12,0)
                 COL(13)  ENTRY(@S3),USE(MO4),REQ,LFT
                 COL(27)  ENTRY(@S12),USE(MONTH4),REQ,LFT
               ROW(10,10) STRING('5:'),HUE(12,0)
                 COL(13)  ENTRY(@S3),USE(MO5),REQ,LFT
                 COL(27)  ENTRY(@S12),USE(MONTH5),REQ,LFT
               ROW(11,10) STRING('6:'),HUE(12,0)
                 COL(13)  ENTRY(@S3),USE(MO6),REQ,LFT
                 COL(27)  ENTRY(@S12),USE(MONTH6),REQ,LFT
