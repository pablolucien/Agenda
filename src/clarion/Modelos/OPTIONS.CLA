             PROGRAM

             INCLUDE('d:\clarion\all_KEYS')

TRUE         EQUATE(1)
FALSE        EQUATE(0)

             MAP
               PROC(MENU)                        !COUNTRY DEPENDENT INFORMATION
               PROC(COLLATE)                     !COLLATING SEQUENCES
               PROC(UL)                          !UPPER/LOWER TRANSLATION
               PROC(MONTHS)                      !MONTH NAMES AND ABBREVIATIONS
               PROC(MESSAGES)                    !CRITICAL ERROR MESSAGES
               PROC(HMESSAGES)                   !HELP ERROR MESSAGES
               PROC(INIT)                        !INITIALIZATION ROUTINE
               PROC(REDOCOLLATE)                 !ASCII -> XLAT
               FUNC(DOANOTHER),LONG
               PROC(GETNAME)
               PROC(MAKECSTR)
               PROC(TIMEAMPM)                    !TIME AM/PM INDICATOR
             .

! THE UNLABELED BYTE FIELDS USED BELOW HOLD 0, AS THE PROGRAMS THAT READ
! THE OPTIONS FILE EXPECT 'C'-TYPE STRINGS.

ISFSIG EQUATE(42886)  !CLARION 1.0 INTRODUCED AT ATLANTA COMDEX 4/28/86

OPTNAME      STRING(80)

OPTIONS      DOS,PRE(OPT),NAME(OPTNAME)
RECORD         RECORD

SIGNATURE        LONG

COLLATE          GROUP                          !COLLATE SEQUENCE TABLE
CO                BYTE,DIM(256)
                 .
UPPER            STRING(50)                     !UPPER CASE LIST
                 BYTE
LOWER            STRING(50)                     !LOWER CASE LIST
                 BYTE

YY GROUP,DIM(12)
MO               STRING(3)                       !MONTH NAME ABBREVIATIONS
                 BYTE
  .
XX GROUP,DIM(12)
MONTH            STRING(12)                      !MONTH NAMES
                 BYTE
  .
ACTION           STRING(7)                       !ACTION
                 BYTE

!DURING ACTUALLY STARTS HERE                     !DURING MESSAGE
                 STRING(1)                       !ALWAYS BLANK
DURING1_G        GROUP
DURING1           STRING(10)                     !DURING MESSAGE
                  STRING(1)                      !ALWAYS BLANK
                  BYTE
                 .

READ_ERROR       STRING(10)                      !ERROR DURING READ MESSAGE
                 BYTE

WRT_ERROR        STRING(10)                      !ERROR DURING WRITE MESSAGE
                 BYTE

DISK_ERROR_G     GROUP
DISK_ERROR        STRING(24)                     !ERROR ON DISK MESSAGE
                  STRING(1)                      !ALWAYS BLANK
                  BYTE
                 .

ERROR_ON_G       GROUP
ERROR_ON          STRING(39)                     !ERROR ON... MESSAGE
                  STRING(1)                      !ALWAYS BLANK
                  BYTE
                 .

GENERAL          STRING(49)                      !GENERAL FAILURE MESSAGE
                 BYTE
PRT_OFF          STRING(49)                      !PRINTER OFF-LINE MESSAGE
                 BYTE
FAT_BAD          STRING(49)                      !BAD FILE ALLOCATION TABLE MSG
                 BYTE
MEM_CORR         STRING(49)                      !MEMORY IMAGE CORRUPTED MSG
                 BYTE
WRIT_PROT        STRING(49)                      !WRITE PROTECTED DISK MSG
                 BYTE
DEV_NOT_RD       STRING(49)                      !DEVICE NOT READY MESSAGE
                 BYTE
CRC_ERROR        STRING(49)                      !CRC DATA ERROR MESSAGE
                 BYTE
SECTOR_LST       STRING(49)                      !SECTOR NOT FOUND MESSAGE
                 BYTE
NO_PAPER         STRING(49)                      !OUT OF PAPER MESSAGE
                 BYTE

ABORT            STRING(35)                      !ABORT MESSAGE
                 BYTE
IGNORE           STRING(35)                      !IGNORE MESSAGE
                 BYTE
RETRY            STRING(35)                      !RETRY MESSAGE
                 BYTE
FAIL             STRING(35)                      !FAIL MESSAGE
                 BYTE
ABORTKEY         STRING(1)
RETRYKEY         STRING(1)
IGNOREKEY        STRING(1)
FAILKEY          STRING(1)

NOHELPAVL        STRING(20)
                 BYTE
HELPNOTFND       STRING(25)
                 BYTE
TOPNOTFND        STRING(35)
                 BYTE
LIBAM            STRING(2)
                 BYTE
LIBPM            STRING(2)
                 BYTE
             . .

           GROUP, OVER(XX)
MONTH1       STRING(12)
             BYTE
MONTH2       STRING(12)
             BYTE
MONTH3       STRING(12)
             BYTE
MONTH4       STRING(12)
             BYTE
MONTH5       STRING(12)
             BYTE
MONTH6       STRING(12)
             BYTE
MONTH7       STRING(12)
             BYTE
MONTH8       STRING(12)
             BYTE
MONTH9       STRING(12)
             BYTE
MONTH10      STRING(12)
             BYTE
MONTH11      STRING(12)
             BYTE
MONTH12      STRING(12)
             BYTE
           .
           GROUP,OVER(YY)
MO1          STRING(3)
             BYTE
MO2          STRING(3)
             BYTE
MO3          STRING(3)
             BYTE
MO4          STRING(3)
             BYTE
MO5          STRING(3)
             BYTE
MO6          STRING(3)
             BYTE
MO7          STRING(3)
             BYTE
MO8          STRING(3)
             BYTE
MO9          STRING(3)
             BYTE
MO10         STRING(3)
             BYTE
MO11         STRING(3)
             BYTE
MO12         STRING(3)
             BYTE
           .

COLLATEX GROUP
COX        BYTE,DIM(256)
         .

SAVESCR      SCREEN       WINDOW(5,80),AT(10,1),HUE(7,0,0),HLP('SAVESCR')
               ROW(1,1)   STRING('…Õ{78}ª')
               ROW(2,1)   REPEAT(3);STRING('∫<0{78}>∫') .
               ROW(5,1)   STRING('»Õ{78}º')
               ROW(3,26)  STRING('Press ''')
                 COL(33)  STRING('Y'),ENH
                 COL(34)  STRING(''' to save your changes')
               ROW(4,19)  STRING('Any other key aborts the changes you''ve made')
SAVENAME       ROW(2,2)   STRING(78)
             .

  CODE

  SETHUE(7,0)                                    !SET WHITE ON BLACK
  BLANK                                          !  AND BLANK
  SETHUE
  HELP('OPTIONS')

  OPTNAME = 'OPTIONS.CTL'

  LOOP                                           !MAIN LOOP

    GETNAME                                      !GET THE OPT CTRL FILE NAME
    IF OPTNAME = '' THEN RETURN.

    OPEN(OPTIONS)                                !OPEN THE FILE
    IF ERROR()                                   !OPEN RETURNED AN ERROR
      CASE ERRORCODE()                           ! CHECK FOR SPECIFIC ERROR
      OF 2                                       !IF NOT FOUND,
        CREATE(OPTIONS)                          ! CREATE
        INIT                                     !CALL SETUP PROCEDURE
        ADD(OPTIONS)                             !ADD THE NEW RECORD
        IF ERROR() THEN LOOP;STOP(NAME(OPTIONS)&ERROR())..! STOP EXECUTION
      ELSE                                       ! ANY OTHER ERROR
        LOOP;STOP(NAME(OPTIONS)&ERROR()).        ! STOP EXECUTION
      .
    ELSE
      GET(OPTIONS,1)
      IF ERROR() THEN LOOP;STOP(NAME(OPTIONS)&ERROR())..! STOP EXECUTION
      IF BYTES(OPTIONS) <> SIZE(OPT:RECORD)      ! FILE NOT RIGHT
        LOOP;STOP(NAME(OPTIONS)&' IS THE WRONG SIZE').
      .
      IF OPT:SIGNATURE <> ISFSIG
        LOOP;STOP(NAME(OPTIONS)&' IS NOT THE CORRECT FORMAT').
      .
      REDOCOLLATE                                !MAKE XLAT TBL TO ASCII
    .

    MENU                                         !COUNTRY DEPENDENT INFORMATION

    REDOCOLLATE                                  !CHANGE COLLATE INTO XLAT TBL

    OPEN(SAVESCR)
    SAVENAME = CENTER(NAME(OPTIONS),SIZE(SAVENAME))
    ASK
    IF KEYCODE() = VAL('Y') OR KEYCODE() = VAL('y')
      MAKECSTR !NULL TERMINATE THE STRINGS
      PUT(OPTIONS,1)
      IF ERROR() THEN LOOP;STOP(NAME(OPTIONS)&ERROR())..! STOP EXECUTION
    .
    CLOSE(SAVESCR)
    CLOSE(OPTIONS)

    IF NOT DOANOTHER()
      BREAK
    .
  .
  RETURN                                         !EXIT TO DOS

MENU         PROCEDURE

SCREEN       SCREEN       WINDOW(18,80),PRE(SCR),HUE(7,0),HLP('MENU')
               ROW(1,1)   STRING('<201,205{78},187>')
               ROW(2,1)   REPEAT(15);STRING('<186,0{78},186>') .
               ROW(17,1)  STRING('<186,0{39},24,0,25,0{36},186>')
               ROW(18,1)  STRING('<200,205{78},188>')
               ROW(2,27)  STRING('COUNTRY DEPENDENT INFORMATION')
               ROW(17,9)  STRING('Enter the number desired or use')
                 COL(45)  STRING('to point and Enter to select')
MENUNAME       ROW(3,2)   STRING(78),HUE(7,0)
               ROW(5,14)  MENU(@S55),USE(MENU_FIELD"),SEL(15,0),REQ,IMM
               ROW(7,26)    STRING('1. COLLATING SEQUENCE'),HUE(10,0)            |
                              DESC('Define the collating sequence of this '      |
                              & 'character set')
               ROW(8,26)    STRING('2. UPPER/LOWER TRANSLATION'),HUE(10,0)       |
                              DESC('Define upper and lower case characters')
               ROW(9,26)    STRING('3. MONTH NAMES & ABBREVIATIONS'),HUE(10,0)   |
                              DESC('Month names and abbreviations used in date ' |
                              & 'pictures')
               ROW(10,26)   STRING('4. CRITICAL ERROR MESSAGES'),HUE(10,0)       |
                              DESC('Critical error popup prompts and messages')
               ROW(11,26)   STRING('5. HELP ERROR MESSAGES'),HUE(10,0)           |
                              DESC('Online help error messages')
               ROW(12,26)   STRING('6. TIME AM/PM INDICATOR'),HUE(10,0)          |
                              DESC('Set AM or PM indicator for time pictures')
               ROW(14,26)   STRING('7. RESET TO DEFAULT VALUES'),HUE(10,0)       |
                              DESC('Reset all data items to their default values')
               ROW(15,26)   STRING('8. QUIT'),HUE(10,0)                          |
                              DESC('Quit this program and return to DOS')
             .            .

  CODE
  OPEN(SCREEN)                                   !OPEN THE MENU SCREEN
  MENUNAME = CENTER(NAME(OPTIONS),SIZE(MENUNAME))
  LOOP                                           !LOOP UNTIL USER EXITS
    ACCEPT                                       !READ A FIELD OR MENU CHOICE
    CASE FIELD()                                 !JUMP TO FIELD EDIT ROUTINE
    OF ?MENU_FIELD"                              !FROM THE MENU FIELD
      EXECUTE CHOICE()                           !  CALL THE SELECTED PROCEDURE
        COLLATE                                  !  COLLATING SEQUENCES
        UL                                       !  UPPER/LOWER TRANSLATION
        MONTHS                                   !  MONTH NAMES AND ABBREVIATIONS
        MESSAGES                                 !  INFORMATION AND ERROR MESSAGES
        HMESSAGES                                !  HELP MESSAGES
        TIMEAMPM                                 !  SET TIME AM PM
        INIT                                     !  RESET DEFAULTS
        RETURN
  . . .
COLLATE      PROCEDURE

SCREEN       SCREEN       WINDOW(25,80),PRE(SCR),HUE(7,0),HLP('COLLATE')
               ROW(1,1)   STRING('’Õ{9}—Õ{68}ª')
               ROW(2,1)   REPEAT(23);STRING('≥<0{9}>≥<0{68}>∫') .
               ROW(25,1)  STRING('‘Õ{9}œÕ{68}º')
               ROW(13,36) STRING('<24>'),ENH
               ROW(14,36) STRING('<25>'),ENH
               ROW(2,37)  STRING('COLLATING SEQUENCES')
               ROW(13,38) STRING('Move Bar Up')
               ROW(14,38) STRING('Move Bar Down')
               ROW(15,36) STRING('-'),ENH
                 COL(38)  STRING('Move Character Up')
               ROW(16,36) STRING('+'),ENH
                 COL(38)  STRING('Move Character Down')
               ROW(18,36) STRING('Press')
                 COL(42)  STRING('ENTER'),ENH
                 COL(48)  STRING('when Done')
SNUM           ROW(3,65)  STRING(3)
C1             ROW(5,14)  STRING(64),HUE(11,0)
C2             ROW(6,14)  STRING(64),HUE(11,0)
C3             ROW(7,14)  STRING(64),HUE(11,0)
C4             ROW(8,14)  STRING(62),HUE(11,0)
MSG            ROW(3,24)  STRING(40),HUE(31,0)
                          REPEAT(23),INDEX(IDX)
               ROW(2,2)     POINT(1,9),USE(?POINT),SEL(14,7)
CH               COL(4)     STRING(1)
CHDEC            COL(6)     STRING(@N3)
             .            .

IDX SHORT

CX       GROUP
CXARR      BYTE,DIM(254)
         .
         GROUP,OVER(CX)
CX1        STRING(64)
CX2        STRING(64)
CX3        STRING(64)
CX4        STRING(62)
         .
CZ       GROUP
           BYTE(0)
CZ1        STRING(254)
           BYTE(255)
         .

CTRL_PGUP    EQUATE(284)                         !CTRL-PGUP KEY
CTRL_PGDN    EQUATE(288)                         !CTRL-PGDN KEY

T   TABLE
TCH   STRING(1)
TCHDEC STRING(@N03)
    .

T1  GROUP
      STRING(1)
      STRING(@N03)
    .

T2  GROUP
      STRING(1)
      STRING(@N03)
    .

TOPLINE SHORT
BOTLINE SHORT(231)

  CODE

  IDX = 1
  OPEN(SCREEN)                                   !OPEN THE SCREEN
  BOTLINE = 254 - 22
  ALERT
  ALERT(ESC_KEY)
  ALERT(GMINUS_KEY)
  ALERT(GPLUS_KEY)
  ALERT(VAL('+'))
  ALERT(VAL('-'))
  ALERT(UP_KEY)
  ALERT(DOWN_KEY)
  ALERT(RIGHT_KEY)
  ALERT(LEFT_KEY)
  CZ = OPT:COLLATE
  CX = CZ1
  DO LOADTABLE
  DO DISPTABLE
  LOOP                                           !LOOP THRU ALL THE FIELDS
    C1 = CX1
    C2 = CX2
    C3 = CX3
    C4 = CX4
    I# = (TOPLINE+IDX-2)/64
    J# = (TOPLINE+IDX-2)%64
    SETHUE(14,7)
    COLOR(ROW(C1)+I#,COL(C1)+J#,1,1)
    SETHUE
    ACCEPT
    MSG = ''
    CASE KEYCODE()
    OF   ENTER_KEY
    OROF CTRL_ENTER
      LOOP I# = 1 TO 254
        GET(T,I#)
        IF ERROR() THEN STOP(ERROR()).
        CXARR[I#] = TCHDEC
      .
      CZ1 = CX
      OPT:COLLATE = CZ
      FREE(T)
      ALERT
      RETURN
    OF   GMINUS_KEY
    OROF VAL('-')
      IF TOPLINE <> 1 OR IDX <> 1
        I# = CXARR[TOPLINE+(IDX-1)]
        J# = CXARR[TOPLINE+(IDX-2)]
        CXARR[TOPLINE+(IDX-1)] = J#
        CXARR[TOPLINE+(IDX-2)] = I#

        GET(T,TOPLINE+(IDX-1))
        IF ERROR() THEN STOP(ERROR()).
        T1 = T

        GET(T,TOPLINE+(IDX-2))
        IF ERROR() THEN STOP(ERROR()).
        T2 = T

        GET(T,TOPLINE+(IDX-1))
        IF ERROR() THEN STOP(ERROR()).
        T = T2
        PUT(T)
        IF ERROR() THEN STOP(ERROR()).

        GET(T,TOPLINE+(IDX-2))
        IF ERROR() THEN STOP(ERROR()).
        T = T1
        PUT(T)
        IF ERROR() THEN STOP(ERROR()).

        IF IDX > 1
          IDX -= 1
        ELSIF TOPLINE > 1
          TOPLINE -= 1
        .
        DO DISPTABLE
      .
    OF   GPLUS_KEY
    OROF VAL('+')
      IF TOPLINE <> BOTLINE OR IDX <> 23
        I# = CXARR[TOPLINE+(IDX-1)]
        J# = CXARR[TOPLINE+IDX]
        CXARR[TOPLINE+(IDX-1)] = J#
        CXARR[TOPLINE+IDX] = I#

        GET(T,TOPLINE+(IDX-1))
        IF ERROR() THEN STOP(ERROR()).
        T1 = T

        GET(T,TOPLINE+IDX)
        IF ERROR() THEN STOP(ERROR()).
        T2 = T

        GET(T,TOPLINE+(IDX-1))
        IF ERROR() THEN STOP(ERROR()).
        T = T2
        PUT(T)
        IF ERROR() THEN STOP(ERROR()).

        GET(T,TOPLINE+IDX)
        IF ERROR() THEN STOP(ERROR()).
        T = T1
        PUT(T)
        IF ERROR() THEN STOP(ERROR()).

        IF IDX < 23
          IDX += 1
        ELSIF TOPLINE < BOTLINE
          TOPLINE += 1
        .
        DO DISPTABLE
      .
    OF   UP_KEY
    OROF LEFT_KEY
      IF IDX > 1
        IDX -= 1
      ELSIF TOPLINE > 1
        TOPLINE -= 1
        SCROLL(2,2,23,9,-1)
        DO DISPFIRST
      .
    OF   DOWN_KEY
    OROF RIGHT_KEY
      IF IDX < 23
        IDX += 1
      ELSIF TOPLINE < BOTLINE
        TOPLINE += 1
        SCROLL(2,2,23,9,1)
        DO DISPLAST
      .
    OF   PGUP_KEY
      IF IDX > 1
        IDX = 1
      ELSIF TOPLINE > 1
        TOPLINE -= 23
        IF TOPLINE < 1
          TOPLINE = 1
        .
        DO DISPTABLE
      .
    OF   PGDN_KEY
      IF IDX < 23
        IDX = 23
      ELSIF TOPLINE < BOTLINE
        TOPLINE += 23
        IF TOPLINE > BOTLINE
          TOPLINE = BOTLINE
        .
        DO DISPTABLE
      .
    OF   CTRL_PGUP
      TOPLINE = 1
      DO DISPTABLE
    OF   CTRL_PGDN
      TOPLINE = BOTLINE
      DO DISPTABLE
    OF   ESC_KEY
      ALERT
      RETURN
    ELSE
      SELECT(1)
    .
  .

LOADTABLE ROUTINE
    FREE(T)
    LOOP I# = 1 TO 254
      TCH = CHR(CXARR[I#])
      TCHDEC =  CXARR[I#]
      ADD(T)
      IF ERROR() THEN STOP(ERROR()).
    .
    TOPLINE = 1

DISPTABLE ROUTINE
    I# = IDX
    LOOP IDX = 1 TO 23
      GET(T,TOPLINE+(IDX-1))
      IF ERROR() THEN STOP(ERROR()).
      CH = TCH
      CHDEC = TCHDEC
    .
    IDX = I#

DISPLAST ROUTINE
    I# = IDX
    IDX = 23
    GET(T,TOPLINE+22)
    IF ERROR() THEN STOP(ERROR()).
    CH = TCH
    CHDEC = TCHDEC
    IDX = I#

DISPFIRST ROUTINE
    I# = IDX
    IDX = 1
    GET(T,TOPLINE)
    IF ERROR() THEN STOP(ERROR()).
    CH = TCH
    CHDEC = TCHDEC
    IDX = I#

UL           PROCEDURE

SCREEN       SCREEN       WINDOW(11,60),PRE(SCR),HUE(7,0),HLP('UL')
               ROW(1,1)   STRING('…Õ{58}ª')
               ROW(2,1)   REPEAT(9);STRING('∫<0{58}>∫') .
               ROW(11,1)  STRING('»Õ{58}º')
               ROW(2,20)  STRING('UPPER/LOWER TRANSLATION'),HUE(12,0)
               ROW(4,6)   STRING('UPPER'),HUE(12,0)
               ROW(7,6)   STRING('LOWER'),HUE(12,0)
ULMSG          ROW(3,11)  STRING(40),HUE(31,0)
               ROW(2,2)   ENTRY,USE(?FIRST)
               ROW(5,6)   ENTRY(@S50),USE(OPT:UPPER),HUE(10,0),REQ,LFT
               ROW(8,6)   ENTRY(@S50),USE(OPT:LOWER),HUE(10,0),REQ,LFT
             .

  CODE
  OPEN(SCREEN)                                   !OPEN THE SCREEN
  DISPLAY
  LOOP                                           !LOOP THRU ALL THE FIELDS
    ACCEPT
    ULMSG = ''
    CASE FIELD()                                 !JUMP TO FIELD EDIT ROUTINE
    OF ?FIRST                                    !UPPER CASE LIST
      IF KEYCODE() = ESC_KEY THEN GOTO ULEDIT.
    OF ?OPT:LOWER                                !LOWER CASE LIST
ULEDIT
      IF LEN(CLIP(OPT:UPPER)) <> LEN(CLIP(OPT:LOWER))
        BEEP
        ULMSG = CENTER('UPPER AND LOWER MUST BE THE SAME SIZE',SIZE(ULMSG))
        SELECT(?OPT:UPPER)
        CYCLE
      .
      RETURN                                     !  AND RETURN TO CALLER
    .
  .

MONTHS       PROCEDURE

