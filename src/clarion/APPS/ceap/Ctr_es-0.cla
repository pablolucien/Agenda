      or materia     = '040-12-042' |
      or materia     = '040-12-046' |
      or materia     = '030-12-014' |
      or materia     = '030-12-015' |
      or materia     = '030-12-013' |
      or materia     = '030-12-016' |
      or materia     = '030-12-012' |
      or materia     = '020-12-024' |
      or materia     = '020-12-025' |
      or materia     = '020-12-021' |
      or materia     = '020-12-022' |
      or materia     = '020-12-023' |
      or materia     = '050-12-033' |
      or materia     = '050-12-031' |
      or materia     = '050-12-034' |
      or materia     = '050-12-032' |
      or materia     = '050-12-035' |
      or materia     = '060-12-053' |
      or materia     = '060-12-054' |
      or materia     = '060-12-055' |
      or materia     = '060-12-052' |
      or materia     = '060-12-051' |
      or materia     = '010-08-111' |
      or materia     = '010-08-113' |
      or materia     = '010-08-112' |
      or materia     = '010-08-023' |
      or materia     = '999-99-001' |
      or materia     = '040-12-009' |
      or materia     = '040-12-012' |
      or materia     = '010-08-033' |
      or materia     = '050-12-032' |
      or materia     = '999-99-002' |
      )
	return(1)
    .
    return(0)


kk procedure
i byte
borrar byte
total long
van   long
  code
     set(al_mat)
     total = records(al_mat)
     van = 0
     loop until eof(al_mat)
	show(25, 1, van/total * 100, @n7~%~)
	van += 1
	next(al_mat)
	borrar = 1
	set(pensa)
	loop until eof(pensa)
	  next(pensa)
	  loop i = 1 to 10
	    if(ama:materia = pen:materias[i])
	      borrar = 0
	    .
	  .
	.
	if(borrar = 1)
	  delete(al_mat)
	.
     .

 fin
