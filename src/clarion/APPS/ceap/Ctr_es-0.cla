	     Member('CTR_EST')


Nombre function(materia, especial)
materia	 byte
especial string(9)
  code
    pen:especialidad = especial
    get(pensa, pen:por_codigo)
    IF ERROR()
      return('')
    .
    return(pen:materias[materia])


SelRec	Function(materia)
materia	 byte
  code
    if(materia > 5 and aes:ingreso < 1993 and (aes:especi = '05-040-12' or aes:especi = '05-060-12'))
      return(0)
    .
    pen:especialidad = aes:especi
    get(pensa, pen:por_codigo)
    IF ERROR()
      return(0)
    .
    if(aes:oblig[materia] = 0 and pen:materias[materia] <> '          ')
      return(1)
    .
    return(0)

GuessIngr  Procedure	     ! Adivina la fecha de ingreso
total long
van   long
  code
    set(al_esp)
    total = records(al_esp)
    van = 0
    loop until eof(al_esp)
      show(25, 1, van/total * 100, @n7~%~)
      van += 1
      next(al_esp)
      ama:codigo      = aes:codigo
      set(ama:por_cedula, ama:por_cedula)
      loop until eof(al_mat)
	next(al_mat)
	if(ama:codigo <> aes:codigo)
	  break
	.
	if((ama:ano > 0 and ama:ano < aes:ingreso) or aes:ingreso = 0)
	  aes:ingreso = ama:ano
	.
      .
      put(al_esp)
      IF ERROR()
	stop('error en put')
	cycle
      .
    .


Cal_Totales Procedure
total long
van   long
i	  byte
limite	  byte
sem_count byte
cur_count byte
sem	  string(3)
  code
    ! Limpiamos el archivo pensa
    set(pensa)
    loop until eof(pensa)
      next(pensa)
      loop i = 1 to maximum(pen:tienen[], 1)
	pen:tienen[i] = 0
	pen:faltan[i] = 0
	pen:cursan[i] = 0
      .
      put(pensa)
    .

    set(al_esp)
    total = records(al_esp)
    van = 0
    loop until eof(al_esp)
      show(25, 1, van/total * 100, @n7~%~)
      van += 1
      next(al_esp)
      ! Si no es de las carreras que interesan, seguimos
      pen:especialidad = aes:especi
      get(pensa, pen:por_codigo)
      IF ERROR()
    !	stop('No es de ninguna especialidad que nos interese')
	cycle
      .

      aes:materias = 0

      if(aes:especi = '05-090-10')	   ! Maestria
	sem_count = 0
	cur_count = 0
	loop i = 1 to 5
	! Asumimos que no tiene los seminarios
	  aes:Oblig[i] = 1     ! 0   ????
	  pen:faltan[i] += 0   ! 1   ????
	.
	! y revisamos a ver si los tiene
	ama:codigo    = aes:codigo
	set(ama:por_cedula, ama:por_cedula)
	loop until eof(al_mat)
	  next(al_mat)
	  if(ama:codigo <> aes:codigo)
	    break
	  .

	  if(Aprobada(ama:nota))
	    mat:codigo = ama:materia
	    get(materi, mat:por_codigo)
	    IF ERROR()
	      stop('error en get materias')
	      cycle
	    .
	    aes:materias += mat:creditos
	  .
	  if(aes:materias > 30)
	    aes:materias = 30
	  .

	  ! Sabemos si es un seminario por el nombre
	  mat:codigo = ama:materia
	  get(materi, mat:por_codigo)
	  IF ERROR()
    !	    stop('La materia ' & ama:codigo & ' no existe')
	    cycle
	  .
	  sem = mat:abrevia
	  if(sem = 'SEM')
	    if(Aprobada(ama:nota))
	      sem_count += 1
	    .
	    if(ama:nota = 'CA')
	      cur_count += 1
	    .
	  .
	.
	if(sem_count > 5)  ! Solo nos interesan 5 seminarios
	  sem_count = 5
	.
  ! ???	       loop i = 1 to sem_count
  ! ???	       aes:oblig[i] = 1
  ! ???	       pen:tienen[i] += 1
  ! ???	       pen:faltan[i] -= 1
  ! ???	     .
	if(sem_count < 5)		   ! ???????
	  aes:oblig[5 - sem_count] = 0	   ! ???????
	  pen:faltan[5 - sem_count] += 1   ! ???????
	.				   ! ???????

	loop i = 1 to cur_count
	  pen:cursan[i] += 1
	.
      else
	! Buscamos cuantas materias aprobadas tiene
	ama:codigo    = aes:codigo
	set(ama:por_cedula, ama:por_cedula)
	loop until eof(al_mat)
	    next(al_mat)
	    if(ama:codigo <> aes:codigo)
	      break
	    .
	  if(Aprobada(ama:nota))
	    mat:codigo = ama:materia
	    get(materi, mat:por_codigo)
	    IF ERROR()
	      stop('error en get materias')
	      cycle
	    .
	    aes:materias += mat:creditos
	  .
	  if(aes:materias > 30)
	    aes:materias = 30
	  .
	.

	if((aes:especi = '05-040-12' or aes:especi = '05-060-12') and aes:ingreso > 1992)
	  limite = 10
	else
	  limite = 5
	.
	loop i = 1 to limite
	! Asumimos que no tiene las materias
	  aes:Oblig[i] = 0
	  pen:faltan[i] += 1
	! y revisamos a ver si las tiene
	  ama:codigo  = aes:codigo
	  ama:materia = pen:materias[i]
	  set(ama:por_materia, ama:por_materia)
	  loop until eof(al_mat)
	    next(al_mat)
	    if(ama:codigo <> aes:codigo or ama:materia <> pen:materias[i])
	      break
	    .
	    if(Aprobada(ama:nota))
	      aes:oblig[i] = 1
	      pen:tienen[i] += 1
	      pen:faltan[i] -= 1
	    .
	    if(ama:nota = 'CA')
	      pen:cursan[i] += 1
	    .
	  .
	.
      .


      ! Actualizamos los registros
      put(al_esp)
      put(pensa)
    .
    return



Aprobada Function(nota)	   ! Dice si una materia esta aprobada
nota string(2)
  code
    if(nota >= 10 or nota = 'SU' or nota = 'AC' or nota = 'AP' or nota = 'CA')
      return(1)
    .
    return(0)




Upd_Pensa    PROCEDURE

i byte

kk group, pre(kkk)
m1	  String(@s10)
m6	  String(@s10)
m2	  String(@s10)
m7	  String(@s10)
m3	  String(@s10)
m8	  String(@s10)
m4	  String(@s10)
m9	  String(@s10)
m5	  String(@s10)
m10	  String(@s10)
  .

SCREEN	     Screen	  Window(15,80),At(7,1),Pre(SCR),Hue(14,1)
	       Row(1,1)	  String('…Õ{78}ª')
	       Row(2,1)	  Repeat(13);String('∫<0{78}>∫') .
	       Row(15,1)  String('»Õ{78}º')
	       Row(3,30)  String('Actualizacion de pensa')
	       Row(7,38)  String('Pre 93')
	       Row(11,38) String('Post 93')
MESSAGE	       Row(4,26)  String(30),Enh
	       Row(4,56)  Entry,Use(?FIRST_FIELD)
	       Row(5,26)  String('Especialidad:')
		 Col(39)  Entry(@p##-###-##p),Use(pen:Especialidad),Req,Num
	       Row(8,10)  Entry(@s10),Use(kkk:m1)
		 Col(23)  Entry(@s10),Use(kkk:m2)
		 Col(36)  Entry(@s10),Use(kkk:m3)
		 Col(49)  Entry(@s10),Use(kkk:m4)
		 Col(62)  Entry(@s10),Use(kkk:m5)
	       Row(12,10) Entry(@s10),Use(kkk:m6)
		 Col(23)  Entry(@s10),Use(kkk:m7)
		 Col(36)  Entry(@s10),Use(kkk:m8)
		 Col(49)  Entry(@s10),Use(kkk:m9)
		 Col(62)  Entry(@s10),Use(kkk:m10)
	       Row(1,52)  Entry,Use(?LAST_FIELD)
		 Col(52)  Pause(''),Use(?DELETE_FIELD)
	     .

  EJECT
  CODE
    DO CALCFIELDS				 !CALCULATE DISPLAY FIELDS
  OPEN(SCREEN)					 !OPEN THE SCREEN
  loop i = 1 to 5
    show(7 + 8, 10 + 13*(i-1), pen:tienen[i], @p<<<<p)
    show(7 + 8, 16 + 13*(i-1), pen:faltan[i], @p<<<<p)
    show(7 + 9, 10 + 13*(i-1), pen:cursan[i], @p<<<<#p)
    show(7 + 12, 10 + 13*(i-1), pen:tienen[i+5], @p<<<<p)
    show(7 + 12, 16 + 13*(i-1), pen:faltan[i+5], @p<<<<p)
    show(7 + 13, 10 + 13*(i-1), pen:cursan[i+5], @p<<<<#p)
  .
  SETCURSOR					 !TURN OFF ANY CURSOR
  DISPLAY					 !DISPLAY THE FIELDS
  LOOP						 !LOOP THRU ALL THE FIELDS
    MEM:MESSAGE = CENTER(MEM:MESSAGE,SIZE(MEM:MESSAGE)) !DISPLAY ACTION MESSAGE
    ALERT					 !RESET ALERTED KEYS
    ALERT(ACCEPT_KEY)				 !ALERT SCREEN ACCEPT KEY
    ALERT(REJECT_KEY)				 !ALERT SCREEN REJECT KEY
    alert(f4_key)
    alert(f5_key)
    alert(alt_f10)
    ACCEPT					 !READ A FIELD
    if keycode() = f4_key   ! calendario
      Calendario
      SELECT(?)			   ! SELECT THIS ENTRY
      CYCLE  ! ® hace falta esto ???
    .
    if keycode() = f5_key   ! control
      xxcontr
      SELECT(?)		    ! SELECT THIS ENTRY
      CYCLE  ! ® hace falta esto ???
    .
    if keycode() = alt_f10	   ! ® Salir del sistema ?
      ConfSalida
      SELECT(?)			   ! SELECT THIS ENTRY
      CYCLE
    .
    IF KEYCODE() = REJECT_KEY THEN RETURN.	 !RETURN ON SCREEN REJECT KEY
    EXECUTE ACTION				 !SET MESSAGE
      MEM:MESSAGE = 'Se agregar† el registro'	 !
      MEM:MESSAGE = 'Se modificar† el registro'	 !
      MEM:MESSAGE = 'Se borrar† el registro'	 !
    .
    IF KEYCODE() = ACCEPT_KEY			 !ON SCREEN ACCEPT KEY
      UPDATE					 !  MOVE ALL FIELDS FROM SCREEN
      SELECT(?)					 !  START WITH CURRENT FIELD
      SELECT					 !  EDIT ALL FIELDS
      CYCLE					 !  GO TO TOP OF LOOP
    .
    CASE FIELD()				 !JUMP TO FIELD EDIT ROUTINE
    OF ?FIRST_FIELD				 !FROM THE FIRST FIELD
      IF KEYCODE() = ESC_KEY THEN RETURN.	 !  RETURN ON ESC KEY
      IF ACTION = 3 THEN SELECT(?DELETE_FIELD).!    OR CONFIRM FOR DELETE

    OF ?pen:Especialidad			 !Codigo de la especialidad
      IF DUPLICATE(pen:Por_codigo)		 !  CHECK FOR DUPLICATE KEY
	MEM:MESSAGE = 'Crea entrada duplicada'	 !    MOVE AN ERROR MESSAGE
	SELECT(?pen:Especialidad)		 !    STAY ON THE SAME FIELD
	BEEP					 !    SOUND THE KEYBOARD ALARM
	CYCLE					 !    AND LOOP AGAIN
      .

    OF ?LAST_FIELD				 !FROM THE LAST FIELD
	   pen:materias[1]    = kkk:m1
	   pen:materias[2]    = kkk:m2
	   pen:materias[3]    = kkk:m3
	   pen:materias[4]    = kkk:m4
	   pen:materias[5]    = kkk:m5
	   pen:materias[6]    = kkk:m6
	   pen:materias[7]    = kkk:m7
	   pen:materias[8]    = kkk:m8
	   pen:materias[9]    = kkk:m9
	   pen:materias[10]   = kkk:m10
	   loop i = 1 to 10
	     if(pen:materias[i] = '000-00-000')
		pen:materias[i] = '          '
	     .
	   .
      EXECUTE ACTION				 !  UPDATE THE FILE
	ADD(pensa)				 !    ADD NEW RECORD
	PUT(pensa)				 !    CHANGE EXISTING RECORD
	DELETE(pensa)				 !    DELETE EXISTING RECORD
      .
      IF ERRORCODE() = 40			 !  DUPLICATE KEY ERROR
	MEM:MESSAGE = ERROR()			 !    DISPLAY ERR MESSAGE
	SELECT(2)				 !    POSITION TO TOP OF FORM
	CYCLE					 !    GET OUT OF EDIT LOOP
      ELSIF ERROR()				 !  CHECK FOR UNEXPECTED ERROR
	STOP(ERROR())				 !    HALT EXECUTION
      .
      ACTION = 0				 !  SET ACTION TO COMPLETE
      RETURN					 !  AND RETURN TO CALLER

    OF ?DELETE_FIELD				 !FROM THE DELETE FIELD
      IF KEYCODE() = ENTER_KEY |		 !  ON ENTER KEY
      OR KEYCODE() = ACCEPT_KEY			 !  OR CTRL-ENTER KEY
	SELECT(?LAST_FIELD)			 !    DELETE THE RECORD
      ELSE					 !  OTHERWISE
	BEEP					 !    BEEP AND ASK AGAIN
  . . .

CALCFIELDS   ROUTINE
  IF FIELD() > ?FIRST_FIELD			 !BEYOND FIRST_FIELD?
    IF KEYCODE() = 0 AND SELECTED() > FIELD() THEN EXIT. !GET OUT IF NOT NONSTOP
  .
  SCR:MESSAGE = MEM:MESSAGE
  kkk:m1  = pen:materias[1]
  kkk:m2  = pen:materias[2]
  kkk:m3  = pen:materias[3]
  kkk:m4  = pen:materias[4]
  kkk:m5  = pen:materias[5]
  kkk:m6  = pen:materias[6]
  kkk:m7  = pen:materias[7]
  kkk:m8  = pen:materias[8]
  kkk:m9  = pen:materias[9]
  kkk:m10 = pen:materias[10]


MatVa Function(codigo, materia) ! Dice si una materia nos interesa para un estudiante
codigo	string(12)
materia string(10)
i	byte
  code
  show (25, 1, materia)
  show (25, 15, codigo)
    ! Buscamos el alumno
    aes:codigo = codigo
    get(al_esp, aes:por_cedula)
    if(error())
      return(0)
    .
    ! y su especialidad
    pen:especialidad = aes:especi
    get(pensa, pen:por_codigo)
    if(error())
      return(0)
    .
    loop i = 1 to maximum(pen:materias[], 1)
      if(pen:materias[i] = materia)
	return(1)
      .
    .
    return(0)



 omit('fin')
