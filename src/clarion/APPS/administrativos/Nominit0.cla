	     Member('NOMINA')
	     ! Otros procedimientos del sistema de nomina
	     !
Initius	     Procedure

Initial	     Screen	  Window(1,80),At(25,1),Hue(1,3)
	       Row(1,20)  String('ข')
		 Col(1)	  String('F1:Ayuda F2:Selecci')
		 Col(21)  String('n de Empresa F3:Memoria F4:Calendario F12:Archivo de '   |
			    & 'Control')
	     .

  Code
    Open(Initial)
    Sel_Company
    Menu


Zero_Bills   Procedure
  ! Pone en cero billetes y monedas para la rutina siguiente
  Code
    mem:bill_500 = 0
    mem:bill_100 = 0
    mem:bill_50	 = 0
    mem:bill_20	 = 0
    mem:bill_10	 = 0
    mem:bill_5	 = 0
    mem:mon_2	 = 0
    mem:mon_1	 = 0



Discrimina   Procedure
  ! Discrimina en billetes y monedas la cantidad rpt:neto
Tempo	Short
  Code
    mem:bill_500 += int(mem:neto / 500)
    Tempo = mem:neto % 500
    mem:bill_100 += int(Tempo / 100)
    tempo = Tempo % 100
    mem:bill_50	 += int(Tempo / 50)
    tempo = Tempo % 50
    mem:bill_20	 += int(Tempo / 20)
    tempo = Tempo % 20
    mem:bill_10	 += int(Tempo / 10)
    tempo = Tempo % 10
    mem:bill_5	 += int(Tempo / 5)
    tempo = Tempo % 5
    mem:mon_2	 += int(Tempo / 2)
    tempo = Tempo % 2
    mem:mon_1	 += Tempo


Rebuild	     procedure
SCREEN	     Screen	  Window(1,80),At(25,1),Hue(0,7)
	     .
Archivo	     string(8)
  CODE
  open(screen)

    Archivo = 'Company'
    SHOW(25,1,CENTER('Reconstruyendo archivo '& archivo,80))
    CLOSE(company)			       !  LET BUILD OPEN FILE UNSHARED
    BUILD(company)			       !  CALL THE BUILD PROCEDURE
    CLOSE(company)			       !  CLOSE UNSHARED FILE
    SHARE(company)			       !  OPEN FILE SHARED

    Archivo = 'Empleado'
    SHOW(25,1,CENTER('Reconstruyendo archivo '& archivo,80))
    CLOSE(empleado)				!  LET BUILD OPEN FILE UNSHARED
    BUILD(empleado)				!  CALL THE BUILD PROCEDURE
    CLOSE(empleado)				!  CLOSE UNSHARED FILE
    SHARE(empleado)				!  OPEN FILE SHARED

    Archivo = 'Nomina'
    SHOW(25,1,CENTER('Reconstruyendo archivo '& archivo,80))
    CLOSE(nomina)			      !	 LET BUILD OPEN FILE UNSHARED
    BUILD(nomina)			      !	 CALL THE BUILD PROCEDURE
    CLOSE(nomina)			      !	 CLOSE UNSHARED FILE
    SHARE(nomina)			      !	 OPEN FILE SHARED

    Archivo = 'Ctrl_Nom'
    SHOW(25,1,CENTER('Reconstruyendo archivo '& archivo,80))
    CLOSE(ctrl_nom)				!  LET BUILD OPEN FILE UNSHARED
    BUILD(ctrl_nom)				!  CALL THE BUILD PROCEDURE
    CLOSE(ctrl_nom)				!  CLOSE UNSHARED FILE
    SHARE(ctrl_nom)				!  OPEN FILE SHARED

    Archivo = 'Seccion'
    SHOW(25,1,CENTER('Reconstruyendo archivo '& archivo,80))
    CLOSE(seccion)			       !  LET BUILD OPEN FILE UNSHARED
    BUILD(seccion)			       !  CALL THE BUILD PROCEDURE
    CLOSE(seccion)			       !  CLOSE UNSHARED FILE
    SHARE(seccion)			       !  OPEN FILE SHARED

    Archivo = 'Asiento'
    SHOW(25,1,CENTER('Reconstruyendo archivo '& archivo,80))
    CLOSE(Asiento)			       !  LET BUILD OPEN FILE UNSHARED
    BUILD(Asiento)			       !  CALL THE BUILD PROCEDURE
    CLOSE(Asiento)			       !  CLOSE UNSHARED FILE
    SHARE(Asiento)			       !  OPEN FILE SHARED

    Archivo = 'Audit'
    SHOW(25,1,CENTER('Reconstruyendo archivo '& archivo,80))
    CLOSE(Audit)			     !	LET BUILD OPEN FILE UNSHARED
    BUILD(Audit)			     !	CALL THE BUILD PROCEDURE
    CLOSE(Audit)			     !	CLOSE UNSHARED FILE
    SHARE(Audit)			     !	OPEN FILE SHARED


!-------------------------------------------------------------------!
!    De aquก hacia arriba las rutinas est n bien (digo yo)	    !
!-------------------------------------------------------------------!

SEL_COMPANY  PROCEDURE

SCREEN	     Screen	  Window(17,32),At(8,1),Pre(SCR),Hue(14,1),Hlp('nada')
	       Row(1,1)	  String('ษอ{30}ป')
	       Row(2,1)	  String('บ<0{11}>ข<0{10}>คก<0{6}>บ')
	       Row(3,1)	  String('ฬอ{30}น')
	       Row(4,1)	  Repeat(13);String('บ<0{30}>บ') .
	       Row(17,1)  String('ศอ{30}ผ')
	       Row(2,6)	  String('Selecci')
		 Col(14)  String('n de compa')
		 Col(26)  String('as')
		 Col(28)  Entry,Use(?FIRST_FIELD)
		 Col(28)  Entry,Use(?PRE_POINT)
			  Repeat(13),Index(NDX)
	       Row(4,2)	    Point(1,30),Use(?POINT),Esc(?-1)
Nombre		 Col(2)	    String(30)
	     .		  .

NDX	     BYTE				 !REPEAT INDEX FOR POINT AREA
ROW	     BYTE				 !ACTUAL ROW OF SCROLL AREA
COL	     BYTE				 !ACTUAL COLUMN OF SCROLL AREA
COUNT	     BYTE(14)				 !NUMBER OF ITEMS TO SCROLL
ROWS	     BYTE(13)				 !NUMBER OF ROWS TO SCROLL
COLS	     BYTE(30)				 !NUMBER OF COLUMNS TO SCROLL
FOUND	     BYTE				 !RECORD FOUND FLAG
NEWPTR	     LONG				 !POINTER TO NEW RECORD

TABLE	     TABLE,PRE(TBL)			 !TABLE OF RECORD DATA
cod_company    Byte				 !Codigo de la empresa
Nombre	       String(30)
PTR	       LONG				 !  POINTER TO FILE RECORD
	     .

  EJECT
  CODE
  if year(today()) > 1992 then return.	 !Cochinada de proteccion ???
  ACTION# = ACTION				 !SAVE ACTION
  BLANK(6, 1, 1, 80)				 ! Limpiar area de status
  Show(5,1,'ฺฤ{78}ฟ',@s80)
  Show(6,1,'ณ<0{78}>ณ',@s80)
  Show(7,1,'ภฤ{78}ู',@s80)
  OPEN(SCREEN)					 !OPEN THE SCREEN
  SETCURSOR					 !TURN OFF ANY CURSOR
  TBL:PTR = 1					 !START AT TABLE ENTRY
  NDX = 1					 !PUT SELECTOR BAR ON TOP ITEM
  ROW = ROW(?POINT)				 !REMEMBER TOP ROW AND
  COL = COL(?POINT)				 !LEFT COLUMN OF SCROLL AREA
  RECORDS# = TRUE				 !INITIALIZE RECORDS FLAG
  IF ACTION = 4					 !  TABLE LOOKUP REQUEST
    NEWPTR = POINTER(company)			 !  SET POINTER TO RECORD
    IF NOT NEWPTR				 !  RECORD NOT PASSED TO TABLE
      SET(com:por_codigo,com:por_codigo)	 !    POSITION TO CLOSEST RECORD
      NEXT(company)				 !    READ RECORD
      NEWPTR = POINTER(company)			 !    SET POINTER
    .
    DO FIND_RECORD				 !  POSITION FILE
  ELSE
    NDX = 1					 !  PUT SELECTOR BAR ON TOP ITEM
    DO FIRST_PAGE				 !  BUILD MEMORY TABLE OF KEYS
  .
  RECORDS# = TRUE				 !  ASSUME THERE ARE RECORDS
  LOOP						 !LOOP UNTIL USER EXITS
    ACTION = ACTION#				 !RESTORE ACTION
    ALERT					 !RESET ALERTED KEYS
    ALERT(REJECT_KEY)				 !ALERT SCREEN REJECT KEY
    ALERT(ACCEPT_KEY)				 !ALERT SCREEN ACCEPT KEY
    ACCEPT					 !READ A FIELD
  ! IF KEYCODE() = REJECT_KEY THEN BREAK.	 !RETURN ON SCREEN REJECT KEY

    IF	KEYCODE() = ACCEPT_KEY	  |		 !ON SCREEN ACCEPT KEY
    AND FIELD() <> ?POINT			 !BUT NOT ON THE POINT FIELD
      UPDATE					 !  MOVE ALL FIELDS FROM SCREEN
      SELECT(?)					 !  START WITH CURRENT FIELD
      SELECT					 !  EDIT ALL FIELDS
      CYCLE					 !  GO TO TOP OF LOOP
    .

    CASE FIELD()				 !JUMP TO FIELD EDIT ROUTINE

    OF ?FIRST_FIELD				 !FROM THE FIRST FIELD
      IF KEYCODE() = ESC_KEY |			 !  RETURN ON ESC KEY
      OR RECORDS# = FALSE			 !  OR NO RECORDS
	BREAK					 !    EXIT PROGRAM
      .
    OF ?PRE_POINT				 !PRE POINT FIELD CONDITION
      IF KEYCODE() = ESC_KEY			 !  BACKING UP?
	SELECT(?-1)				 !    SELECT PREVIOUS FIELD
      ELSE					 !  GOING FORWARD
	SELECT(?POINT)				 !    SELECT MENU FIELD
      .
    OF ?POINT					 !PROCESS THE POINT FIELD
      IF RECORDS(TABLE) = 0			 !IF THERE ARE NO RECORDS
	CLEAR(com:RECORD)			 !  CLEAR RECORD AREA
	UPDATE					 !  UPDATE ALL FIELDS
	ACTION = 1				 !  SET ACTION TO ADD
	GET(company,0)				 !  CLEAR PENDING RECORD
	NEWPTR = POINTER(company)		 !    SET POINTER TO NEW RECORD
	DO FIRST_PAGE				 !  DISPLAY THE FIRST PAGE
	IF RECORDS(TABLE) = 0			 !  IF THERE AREN'T ANY RECORDS
	  RECORDS# = FALSE			 !    INDICATE NO RECORDS
	  SELECT(?PRE_POINT-1)			 !    SELECT THE PRIOR FIELD
	.
	CYCLE					 !    AND LOOP AGAIN
      .
      CASE KEYCODE()				 !PROCESS THE KEYSTROKE

      OF ENTER_KEY				 !ENTER KEY
      OROF ACCEPT_KEY				 !CTRL-ENTER KEY
	DO GET_RECORD				 !  GET THE SELECTED RECORD
	IF ACTION = 4 AND KEYCODE() = ENTER_KEY!    IF THIS IS A LOOKUP REQUEST
	  ACTION = 0				 !    SET ACTION TO COMPLETE
	  BREAK					 !    AND RETURN TO CALLER
	.
	IF ~ERROR()				 !  IF RECORD IS STILL THERE
	  ACTION = 2				 !    SET ACTION TO CHANGE
	  mem:cod_company = com:cod_company	 !Preparar los archivos
	  nom:cod_company = mem:cod_company	 ! para LOOKUP y RECORD SELECTOR
	  emp:cod_company = mem:cod_company
	  mem:semana = com:nom_actual
	  ctr:cod_company = mem:cod_company
	  ctr:semana = com:nom_actual
	  get(ctrl_nom, por_semana)
	  mem:f_desde = ctr:f_desde
	  mem:f_hasta = ctr:f_hasta
	  mem:f_pago  = ctr:f_pago
   !	  scr:nombre = com:nombre
	  Show(6, 2, com:nombre, @s30)
	  Show(6, 33, mem:f_desde , @d5)
	  Show(6, 41, '-', @s1)
	  Show(6, 42, mem:f_hasta, @d5)
	  return
   !	  IF ACTION THEN CYCLE.			 !    IF SUCCESSFUL RE-DISPLAY
	.
	NEWPTR = POINTER(company)		 !    SET POINTER TO NEW RECORD
	DO FIND_RECORD				 !    POSITION IN FILE

      OF DOWN_KEY				 !DOWN ARROW KEY
	DO SET_NEXT				 !  POINT TO NEXT RECORD
	DO FILL_NEXT				 !  FILL A TABLE ENTRY
	IF FOUND				 !  FOUND A NEW RECORD
	  SCROLL(ROW,COL,ROWS,COLS,ROWS(?POINT)) !    SCROLL THE SCREEN UP
	  GET(TABLE,RECORDS(TABLE))		 !  GET RECORD FROM TABLE
	  DO FILL_SCREEN			 !  DISPLAY ON SCREEN
	.

      OF PGDN_KEY				 !PAGE DOWN KEY
	DO SET_NEXT				 !  POINT TO NEXT RECORD
	DO NEXT_PAGE				 !  DISPLAY THE NEXT PAGE

      OF CTRL_PGDN				 !CTRL-PAGE DOWN KEY
	DO LAST_PAGE				 !  DISPLAY THE LAST PAGE
	NDX = RECORDS(TABLE)			 !  POSITION POINT BAR

      OF UP_KEY					 !UP ARROW KEY
	DO SET_PREV				 !  POINT TO PREVIOUS RECORD
	DO FILL_PREV				 !  FILL A TABLE ENTRY
	IF FOUND				 !  FOUND A NEW RECORD
	  SCROLL(ROW,COL,ROWS,COLS,-(ROWS(?POINT)))! SCROLL THE SCREEN DOWN
	  GET(TABLE,1)				 !  GET RECORD FROM TABLE
	  DO FILL_SCREEN			 !  DISPLAY ON SCREEN
	.

      OF PGUP_KEY				 !PAGE UP KEY
	DO SET_PREV				 !  POINT TO PREVIOUS RECORD
	DO PREV_PAGE				 !  DISPLAY THE PREVIOUS PAGE

      OF CTRL_PGUP				 !CTRL-PAGE UP
	DO FIRST_PAGE				 !  DISPLAY THE FIRST PAGE
	NDX = 1					 !  POSITION POINT BAR
  . . .
  FREE(TABLE)					 !FREE MEMORY TABLE
  scr:nombre = com:nombre
  Show(5,2,scr:nombre,@s78)
  RETURN					 !AND RETURN TO CALLER

SAME_PAGE ROUTINE				 !DISPLAY THE SAME PAGE
  GET(TABLE,1)					 !  GET THE FIRST TABLE ENTRY
  DO FILL_RECORD				 !  FILL IN THE RECORD
  SET(com:por_codigo,com:por_codigo,TBL:PTR)	 !  POSITION FILE
  FREE(TABLE)					 !  EMPTY THE TABLE
  DO NEXT_PAGE					 !  DISPLAY A FULL PAGE

FIRST_PAGE ROUTINE				 !DISPLAY FIRST PAGE
  BLANK(ROW,COL,ROWS,COLS)
  FREE(TABLE)					 !  EMPTY THE TABLE
  CLEAR(com:RECORD,-1)				 !  CLEAR RECORD TO LOW VALUES
  CLEAR(TBL:PTR)				 !  ZERO RECORD POINTER
  SET(com:por_codigo)				 !  POINT TO FIRST RECORD
  LOOP NDX = 1 TO COUNT				 !  FILL UP THE TABLE
    DO FILL_NEXT				 !    FILL A TABLE ENTRY
    IF NOT FOUND THEN BREAK.			 !    GET OUT IF NO RECORD
  .
  NDX = 1					 !  SET TO TOP OF TABLE
  DO SHOW_PAGE					 !  DISPLAY THE PAGE

LAST_PAGE ROUTINE				 !DISPLAY LAST PAGE
  NDX# = NDX					 !  SAVE SELECTOR POSITION
  BLANK(ROW,COL,ROWS,COLS)			 !  CLEAR SCROLLING AREA
  FREE(TABLE)					 !  EMPTY THE TABLE
  CLEAR(com:RECORD,1)				 !  CLEAR RECORD TO HIGH VALUES
  CLEAR(TBL:PTR,1)				 !  CLEAR PTR TO HIGH VALUE
  SET(com:por_codigo)				 !  POINT TO FIRST RECORD
  LOOP NDX = COUNT TO 1 BY -1			 !  FILL UP THE TABLE
    DO FILL_PREV				 !    FILL A TABLE ENTRY
    IF NOT FOUND THEN BREAK.			 !    GET OUT IF NO RECORD
  .
  NDX = NDX#					 !  RESTORE SELECTOR POSITION
  DO SHOW_PAGE					 !  DISPLAY THE PAGE

FIND_RECORD ROUTINE				 !POSITION TO SPECIFIC RECORD
  SET(com:por_codigo,com:por_codigo,NEWPTR)	 !POSITION FILE
  IF NEWPTR = 0					 !NEWPTR NOT SET
    NEXT(company)				 !  READ NEXT RECORD
    NEWPTR = POINTER(company)			 !  SET NEWPTR
    SKIP(company,-1)				 !  BACK UP TO DISPLAY RECORD
  .
  FREE(TABLE)					 !  CLEAR THE RECORD
  DO NEXT_PAGE					 !  DISPLAY A PAGE

NEXT_PAGE ROUTINE				 !DISPLAY NEXT PAGE
  SAVECNT# = RECORDS(TABLE)			 !  SAVE RECORD COUNT
  LOOP COUNT TIMES				 !  FILL UP THE TABLE
    DO FILL_NEXT				 !    FILL A TABLE ENTRY
    IF NOT FOUND				 !    IF NONE ARE LEFT
      IF NOT SAVECNT#				 !	IF REBUILDING TABLE
	DO LAST_PAGE				 !	FILL IN RECORDS
	EXIT					 !	EXIT OUT OF ROUTINE
      .
      BREAK					 !    EXIT LOOP
  . .
  DO SHOW_PAGE					 !  DISPLAY THE PAGE

SET_NEXT ROUTINE				 !POINT TO THE NEXT PAGE
  GET(TABLE,RECORDS(TABLE))			 !  GET THE LAST TABLE ENTRY
  DO FILL_RECORD				 !  FILL IN THE RECORD
  SET(com:por_codigo,com:por_codigo,TBL:PTR)	 !  POSITION FILE
  NEXT(company)					 !  READ THE CURRENT RECORD

FILL_NEXT ROUTINE				 !FILL NEXT TABLE ENTRY
  FOUND = FALSE					 !  ASSUME RECORD NOT FOUND
  LOOP UNTIL EOF(company)			 !  LOOP UNTIL END OF FILE
    NEXT(company)				 !    READ THE NEXT RECORD
    FOUND = TRUE				 !    SET RECORD FOUND
    DO FILL_TABLE				 !    FILL IN THE TABLE ENTRY
    ADD(TABLE)					 !    ADD LAST TABLE ENTRY
    GET(TABLE,RECORDS(TABLE)-COUNT)		 !    GET ANY OVERFLOW RECORD
    DELETE(TABLE)				 !    AND DELETE IT
    EXIT					 !    RETURN TO CALLER
  .
PREV_PAGE ROUTINE				 !DISPLAY PREVIOUS PAGE
  LOOP COUNT TIMES				 !  FILL UP THE TABLE
    DO FILL_PREV				 !    FILL A TABLE ENTRY
    IF NOT FOUND THEN BREAK.			 !    GET OUT IF NO RECORD
  .
  DO SHOW_PAGE					 !  DISPLAY THE PAGE

SET_PREV ROUTINE				 !POINT TO PREVIOUS PAGE
  GET(TABLE,1)					 !  GET THE FIRST TABLE ENTRY
  DO FILL_RECORD				 !  FILL IN THE RECORD
  SET(com:por_codigo,com:por_codigo,TBL:PTR)	 !  POSITION FILE
  PREVIOUS(company)				 !  READ THE CURRENT RECORD

FILL_PREV ROUTINE				 !FILL PREVIOUS TABLE ENTRY
  FOUND = FALSE					 !  ASSUME RECORD NOT FOUND
  LOOP UNTIL BOF(company)			 !  LOOP UNTIL BEGINNING OF FILE
    PREVIOUS(company)				 !    READ THE PREVIOUS RECORD
    FOUND = TRUE				 !    SET RECORD FOUND
    DO FILL_TABLE				 !    FILL IN THE TABLE ENTRY
    ADD(TABLE,1)				 !    ADD FIRST TABLE ENTRY
    GET(TABLE,COUNT+1)				 !    GET ANY OVERFLOW RECORD
    DELETE(TABLE)				 !    AND DELETE IT
    EXIT					 !    RETURN TO CALLER
  .
SHOW_PAGE ROUTINE				 !DISPLAY THE PAGE
  NDX# = NDX					 !  SAVE SCREEN INDEX
  LOOP NDX = 1 TO RECORDS(TABLE)		 !  LOOP THRU THE TABLE
    GET(TABLE,NDX)				 !    GET A TABLE ENTRY
    DO FILL_SCREEN				 !    AND DISPLAY IT
    IF TBL:PTR = NEWPTR				 !    SET INDEX FOR NEW RECORD
      NDX# = NDX				 !    POINT TO CORRECT RECORD
  . .
  NDX = NDX#					 !  RESTORE SCREEN INDEX
  NEWPTR = 0					 !  CLEAR NEW RECORD POINTER
  CLEAR(com:RECORD)				 !  CLEAR RECORD AREA

FILL_TABLE ROUTINE				 !MOVE FILE TO TABLE
  TBL:cod_company = com:cod_company
  TBL:Nombre = com:Nombre
  TBL:PTR = POINTER(company)			 !  SAVE RECORD POINTER

FILL_RECORD ROUTINE				 !MOVE TABLE TO FILE
  com:cod_company = TBL:cod_company

FILL_SCREEN ROUTINE				 !MOVE TABLE TO SCREEN
  SCR:Nombre = TBL:Nombre

GET_RECORD ROUTINE				 !GET SELECTED RECORD
  GET(TABLE,NDX)				 !  GET TABLE ENTRY
  GET(company,TBL:PTR)				 !  GET THE RECORD



Seleccion    procedure
  code
    com:cod_company = mem:cod_company	   !Preparar los archivos
    emp:cod_company = mem:cod_company
    nom:cod_company = mem:cod_company	   ! para LOOKUP y RECORD SELECTOR
    nom:semana	    = mem:semana	   ! para LOOKUP y RECORD SELECTOR
    nom:tipo	    = mem:tipo_nomina
    emp:tipo	    = mem:tipo_nomina
    SET(com:por_codigo)			   !	POSITION TO CLOSEST RECORD
    ! next(company)
    get(company, com:por_codigo)
    ctr:cod_company = com:cod_company	   ! Leer el registro de control
    ctr:semana = com:nom_actual ! 1
    SET(emp:por_company)		   !	POSITION TO CLOSEST RECORD
    SET(nom:por_company)		   !	POSITION TO CLOSEST RECORD



Set_Nom	     procedure
  Code
  ! Prepara datos basicos de la nomina a generar
  ! ??? Esto debe estar el la rutina que selecciona compaคกa

    com:cod_company = mem:cod_company
    get(company, com:por_codigo)
    mem:semana = com:nom_actual !+ 1
    ctr:cod_company = mem:cod_company
    ctr:semana = com:nom_actual
    get(ctrl_nom, por_semana)
    mem:f_desde = ctr:f_desde + 7
    mem:f_hasta = ctr:f_hasta + 7
    mem:f_pago	= ctr:f_pago  + 7


Genera_nom   procedure
  Code
  ! Generar registros de nomina
    SET(empleado)			   !Ir al primer registro
    loop until(eof(empleado))		   ! ??? revisar esto: hacer el acceso por clave
      next(empleado)
      if emp:cod_company <> mem:cod_company then cycle.
      if emp:tipo	 <> mem:tipo_nomina then cycle.
      if emp:Activo = 'I' then cycle.
      if emp:Activo = 'V' then		   ! Esta de vacaciones
	do Nom_Vacacion
      elsif emp:Status <> 'N'		   ! Ha sido modificado o es nuevo
	do Nom_original
      else
	nom:cod_company	  =   mem:cod_company
	nom:Semana	  =   mem:semana -1 !- 1 Esto es lo que causa la generaciขn original
	nom:cod_empleado  =   emp:cod_empleado
	nom:Cod_Seccion	  =   emp:Cod_seccion
	! set(nomina, nom:Por_Company)
	get(nomina, nom:Por_Company)
	if Error() then
	  beep
 !	SHOW(25,1,CENTER(error(),80))
	  do Nom_original
	else
	  nom:Semana	    =	mem:semana !+1 o mejor com:nom_actual
	! put(nomina)
	.
      .
	add(nomina)
    .

	     ! Generar registro de control de nomina
    ctr:cod_company	=   mem:cod_company
    ctr:Semana		=   mem:semana
    ctr:f_desde		=   mem:f_desde
    ctr:f_hasta		=   mem:f_hasta
    ctr:f_pago		=   mem:f_pago
    ctr:cerrada		=   'N'
    add(ctrl_nom)
	     ! Actualizar registro de compaคกa
    com:cod_company = mem:cod_company
    get(company, com:por_codigo)
    com:nom_actual = mem:semana
    put(company)


Nom_Original Routine
	nom:cod_company	  =   mem:cod_company
	nom:Semana	  =   mem:semana
	nom:cod_empleado  =   emp:cod_empleado
	nom:Cod_Seccion	  =   emp:Cod_seccion
	nom:Tipo	  =   emp:tipo
	nom:Sal_base	  =   emp:sueldo_act
	nom:Dias_trabajo  =   8
	nom:Sal_Ord	  =   nom:sal_base*nom:dias_trabajo
	nom:H_E_dia	  =   0
	nom:H_E_noche	  =   0
	nom:Desc_ingreso  =   ''
	nom:Monto_ingres  =   0
	Calc_Deds			     ! Calcula las deducciones
	if emp:prestamo > emp:amort_presta then
	  nom:prestamo	  =   emp:amort_presta
	else
	  nom:prestamo	  =   emp:prestamo.
	nom:Desc_Egreso	  =   ''
	nom:Monto_Egreso  =   0
	emp:Status	  =  'N'
	put(empleado)

Nom_Vacacion Routine
	nom:cod_company	  =   mem:cod_company
	nom:Semana	  =   mem:semana
	nom:cod_empleado  =   emp:cod_empleado
	nom:Cod_Seccion	  =   emp:Cod_seccion
	nom:Tipo	  =   emp:tipo
	nom:Sal_base	  =   emp:sueldo_act
	nom:Dias_trabajo  =   0
	nom:Sal_Ord	  =   0
	nom:H_E_dia	  =   0
	nom:H_E_noche	  =   0
	nom:Desc_ingreso  =   ''
	nom:Monto_ingres  =   0
	nom:Polit_habit	  =   0
	nom:S_S_O	  =   0
	nom:Paro_forzoso =    0
	nom:I_S_R	  =   0
	nom:prestamo	  =   0
	nom:Desc_Egreso	  =   ''
	nom:Monto_Egreso  =   0
	emp:Status	  =  'N'
	put(empleado)

Calc_Deds   Procedure
  ! Calculo de deducciones en el mapa de modificacion de nomina
  Code
  nom:Polit_habit   =	0.01*nom:dias_trabajo*nom:sal_base
  if	nom:Sal_Ord < 1500
    nom:S_S_O	    =	0
    nom:Paro_forzoso =	0
  elsif nom:Sal_Ord > 3750
    if emp:tipo = 'E' then
      nom:S_S_O	     =	600 / 4
    else
      nom:S_S_O	     =	300 / 4
    .
    nom:Paro_forzoso =	Nom:Sal_Ord * 0.0025
  else
    if emp:tipo = 'E' then
      nom:S_S_O	     =	Nom:Sal_Ord * 0.04
    else
      nom:S_S_O	     =	Nom:Sal_Ord * 0.02
    .
    nom:Paro_forzoso =	Nom:Sal_Ord * 0.0025
  .
  nom:I_S_R	    =	0


Cierra_Nom   PROCEDURE
  Code
  ! Cierre de una nomina
  ! debe Hacerse despues de emitir los reportes
  ! pero antes de emitir el reporte al banco
					   !Preparar los archivos
    ctr:cod_company = mem:cod_company	   ! Leer el registro de control
    ctr:semana = mem:semana
    get(ctrl_nom,por_semana)
    if ctr:cerrada = 'S' then return.	   ! Ya esta cerrada

    nom:cod_company  = ctr:cod_company
    nom:semana	     = ctr:semana
    nom:cod_empleado = 0
    SET(nom:por_company)
	   !
	   !	Begin Transaction
	   !
    loop until eof(nomina)
      next(nomina)
      if nom:cod_company <> ctr:cod_company then break.	   ! Ruptura

      emp:cod_company  = nom:cod_company		   ! Actualizar Empleado
      emp:cod_empleado = nom:cod_empleado
      get(empleado,emp:por_company)
      emp:prestamo -= nom:prestamo
      emp:Total_Pagado = 100
      put(empleado)
    .
    com:cod_company  = ctr:cod_company			 ! Actualizar Compaคกa
    get(company,com:por_codigo)
    com:nom_actual = ctr:semana + 1			 !Listos para la proxima semana
    mem:semana	   = ctr:semana + 1
    put(company)
    ctr:cerrada = 'S'
    put(ctrl_nom)
	   !
	   !	End Transaction
	   !


Prev	     Function
  ! Retorna el numero de dias de preaviso que corresponden a un empleado
  ! segun la ley
Meses	     short	  !numero de meses trabajados
  code
  !   meses = 12 * anos (today() - emp:f_ingreso)

  if emp:f_egreso = 0
     meses = int((today() - emp:f_ingreso)) % 30
  else
     meses = int((emp:f_egreso - emp:f_ingreso)) % 30
  .
  if	meses = 0
	  return(0)
  elsif meses < 6
	  return(7)
  elsif meses < 12
	  return(15)
  elsif meses < 60
	  return(30)
  else
	  return(60)
  .


Anti	     Function
  ! Retorna el numero de dias de antigedad que corresponden a un empleado
  ! segun la ley
Meses	     short	  !numero de meses trabajados
  code
  if emp:f_egreso = 0
     meses = (today() - emp:f_ingreso) / 30
  else
     meses = int((emp:f_egreso - emp:f_ingreso)) / 30
  .
  if	meses < 3
	  return(0)
  elsif meses < 6
	  return(10)
  elsif meses < 18
	  return(30)
  elsif meses < 30
	  return(60)
  elsif meses < 42
	  return(90)
  elsif meses < 54
	  return(120)
  else
	  return(150)
  .


Vac	     Function
  ! Retorna el numero de dias de vacaciones que corresponden a un empleado
  ! segun la ley
Meses	     short	  !numero de meses trabajados
  code
  if emp:f_egreso = 0
     meses = Intervalo('M', today(), emp:f_ingreso)
  else
     meses = Intervalo('M', emp:f_egreso, emp:f_ingreso)
  .
  return(1.9 * meses)	    ! Hay que hacer esto ???



Intervalo    Function(tipo, fecha_1, fecha_2)
  ! Calcula la cantidad de aคos, meses o dia completos entre dos fechas
tipo	     string(1)
fecha_1	     long
fecha_2	     long
fecha_tmp    long
d1	     short
m1	     short
a1	     short
d2	     short
m2	     short
a2	     short
  code
     if fecha_1 < fecha_2 then
       fecha_tmp = fecha_1
       fecha_1	 = fecha_2
       fecha_2	 = fecha_tmp
     .
     fecha_1  += 1
  d1 = day(fecha_1)
  m1 = month(fecha_1)
  a1 = year(fecha_1)
  d2 = day(fecha_2)
  m2 = month(fecha_2)
  a2 = year(fecha_2)
  if d1 < d2
     d1 += 30
     m1 -=  1
  .
  if m1 < m2
     m1 += 12
     a1 -= 1
  .
  case tipo
    of 'A'
      return (a1 - a2)
    of 'M'
      return (m1 - m2)
    of 'D'
      return (d1 - d2)
  .

control	     PROCEDURE

SCREEN	     Screen	  Window(7,75),At(9,3),Pre(SCR),Hue(0,7)
 OMIT('**-END-**')
  ษอออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออป
  บ				Datos de control			    บ
  ฬอออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออน
  บ Disco de Datos:þ							    บ
  บ Directorio:þþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþ บ
  บ PassWord:þþþþþþþþþþ							    บ
  ศอออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออผ
