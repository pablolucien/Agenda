	       Row(4,2)	    Point(1,30),Use(?POINT),Esc(?-1)
Nombre		 Col(2)	    String(30)
	     .		  .

NDX	     BYTE				 !REPEAT INDEX FOR POINT AREA
ROW	     BYTE				 !ACTUAL ROW OF SCROLL AREA
COL	     BYTE				 !ACTUAL COLUMN OF SCROLL AREA
COUNT	     BYTE(14)				 !NUMBER OF ITEMS TO SCROLL
ROWS	     BYTE(13)				 !NUMBER OF ROWS TO SCROLL
COLS	     BYTE(30)				 !NUMBER OF COLUMNS TO SCROLL
FOUND	     BYTE				 !RECORD FOUND FLAG
NEWPTR	     LONG				 !POINTER TO NEW RECORD

TABLE	     TABLE,PRE(TBL)			 !TABLE OF RECORD DATA
cod_company    Byte				 !Codigo de la empresa
Nombre	       String(30)
PTR	       LONG				 !  POINTER TO FILE RECORD
	     .

  EJECT
  CODE
  ACTION# = ACTION				 !SAVE ACTION
  mem:Cod_Company = 0
  BLANK(6, 1, 1, 80)				 ! Limpiar area de status
  Show(5,1,'ÚÄ{78}¿',@s80)
  Show(6,1,'³<0{78}>³',@s80)
  Show(7,1,'ÀÄ{78}Ù',@s80)
  OPEN(SCREEN)					 !OPEN THE SCREEN
  SETCURSOR					 !TURN OFF ANY CURSOR
  TBL:PTR = 1					 !START AT TABLE ENTRY
  NDX = 1					 !PUT SELECTOR BAR ON TOP ITEM
  ROW = ROW(?POINT)				 !REMEMBER TOP ROW AND
  COL = COL(?POINT)				 !LEFT COLUMN OF SCROLL AREA
  RECORDS# = TRUE				 !INITIALIZE RECORDS FLAG
  IF ACTION = 4					 !  TABLE LOOKUP REQUEST
    NEWPTR = POINTER(company)			 !  SET POINTER TO RECORD
    IF NOT NEWPTR				 !  RECORD NOT PASSED TO TABLE
      SET(com:por_codigo,com:por_codigo)	 !    POSITION TO CLOSEST RECORD
      NEXT(company)				 !    READ RECORD
      NEWPTR = POINTER(company)			 !    SET POINTER
    .
    DO FIND_RECORD				 !  POSITION FILE
  ELSE
    NDX = 1					 !  PUT SELECTOR BAR ON TOP ITEM
    DO FIRST_PAGE				 !  BUILD MEMORY TABLE OF KEYS
  .
  RECORDS# = TRUE				 !  ASSUME THERE ARE RECORDS
  LOOP						 !LOOP UNTIL USER EXITS
    ACTION = ACTION#				 !RESTORE ACTION
    ALERT					 !RESET ALERTED KEYS
    ALERT(REJECT_KEY)				 !ALERT SCREEN REJECT KEY
    ALERT(ACCEPT_KEY)				 !ALERT SCREEN ACCEPT KEY
    ACCEPT					 !READ A FIELD
  ! IF KEYCODE() = REJECT_KEY THEN BREAK.	 !RETURN ON SCREEN REJECT KEY

    IF	KEYCODE() = ACCEPT_KEY	  |		 !ON SCREEN ACCEPT KEY
    AND FIELD() <> ?POINT			 !BUT NOT ON THE POINT FIELD
      UPDATE					 !  MOVE ALL FIELDS FROM SCREEN
      SELECT(?)					 !  START WITH CURRENT FIELD
      SELECT					 !  EDIT ALL FIELDS
      CYCLE					 !  GO TO TOP OF LOOP
    .

    CASE FIELD()				 !JUMP TO FIELD EDIT ROUTINE

    OF ?FIRST_FIELD				 !FROM THE FIRST FIELD
      IF KEYCODE() = ESC_KEY |			 !  RETURN ON ESC KEY
      OR RECORDS# = FALSE			 !  OR NO RECORDS
	BREAK					 !    EXIT PROGRAM
      .
    OF ?PRE_POINT				 !PRE POINT FIELD CONDITION
      IF KEYCODE() = ESC_KEY			 !  BACKING UP?
	SELECT(?-1)				 !    SELECT PREVIOUS FIELD
      ELSE					 !  GOING FORWARD
	SELECT(?POINT)				 !    SELECT MENU FIELD
      .
    OF ?POINT					 !PROCESS THE POINT FIELD
      IF RECORDS(TABLE) = 0			 !IF THERE ARE NO RECORDS
	CLEAR(com:RECORD)			 !  CLEAR RECORD AREA
	UPDATE					 !  UPDATE ALL FIELDS
	ACTION = 1				 !  SET ACTION TO ADD
	GET(company,0)				 !  CLEAR PENDING RECORD
	NEWPTR = POINTER(company)		 !    SET POINTER TO NEW RECORD
	DO FIRST_PAGE				 !  DISPLAY THE FIRST PAGE
	IF RECORDS(TABLE) = 0			 !  IF THERE AREN'T ANY RECORDS
	  RECORDS# = FALSE			 !    INDICATE NO RECORDS
	  SELECT(?PRE_POINT-1)			 !    SELECT THE PRIOR FIELD
	.
	CYCLE					 !    AND LOOP AGAIN
      .
      CASE KEYCODE()				 !PROCESS THE KEYSTROKE

      OF ENTER_KEY				 !ENTER KEY
      OROF ACCEPT_KEY				 !CTRL-ENTER KEY
	DO GET_RECORD				 !  GET THE SELECTED RECORD
	IF ACTION = 4 AND KEYCODE() = ENTER_KEY!    IF THIS IS A LOOKUP REQUEST
	  ACTION = 0				 !    SET ACTION TO COMPLETE
	  BREAK					 !    AND RETURN TO CALLER
	.
	IF ~ERROR()				 !  IF RECORD IS STILL THERE
	  ACTION = 2				 !    SET ACTION TO CHANGE
	  mem:cod_company = com:cod_company	 !Preparar los archivos
	  nom:cod_company = mem:cod_company	 ! para LOOKUP y RECORD SELECTOR
	  emp:cod_company = mem:cod_company
	  mem:semana = 1 !com:nom_actual
	  ctr:cod_company = mem:cod_company
	  ctr:semana = 1 !com:nom_actual
	  get(ctrl_nom, por_semana)
	  mem:f_desde = ctr:f_desde
	  mem:f_hasta = ctr:f_hasta
	  mem:f_pago  = ctr:f_pago
	  mem:f_desde_q = ctr:f_desde_q
	  mem:f_hasta_q = ctr:f_hasta_q
	  mem:f_pago_q = ctr:f_pago_q
   !	  scr:nombre = com:nombre
	  Show(6, 2, com:nombre, @s30)
   !	  Show(6, 33, mem:f_desde , @d5)
   !	  Show(6, 41, '-', @s1)
   !	  Show(6, 42, mem:f_hasta, @d5)
	  loop while keyboard()		     ! chupate los caracters extra
	    ask
	  .
	  return
   !	  IF ACTION THEN CYCLE.			 !    IF SUCCESSFUL RE-DISPLAY
	.
	NEWPTR = POINTER(company)		 !    SET POINTER TO NEW RECORD
	DO FIND_RECORD				 !    POSITION IN FILE

      OF DOWN_KEY				 !DOWN ARROW KEY
	DO SET_NEXT				 !  POINT TO NEXT RECORD
	DO FILL_NEXT				 !  FILL A TABLE ENTRY
	IF FOUND				 !  FOUND A NEW RECORD
	  SCROLL(ROW,COL,ROWS,COLS,ROWS(?POINT)) !    SCROLL THE SCREEN UP
	  GET(TABLE,RECORDS(TABLE))		 !  GET RECORD FROM TABLE
	  DO FILL_SCREEN			 !  DISPLAY ON SCREEN
	.

      OF PGDN_KEY				 !PAGE DOWN KEY
	DO SET_NEXT				 !  POINT TO NEXT RECORD
	DO NEXT_PAGE				 !  DISPLAY THE NEXT PAGE

      OF CTRL_PGDN				 !CTRL-PAGE DOWN KEY
	DO LAST_PAGE				 !  DISPLAY THE LAST PAGE
	NDX = RECORDS(TABLE)			 !  POSITION POINT BAR

      OF UP_KEY					 !UP ARROW KEY
	DO SET_PREV				 !  POINT TO PREVIOUS RECORD
	DO FILL_PREV				 !  FILL A TABLE ENTRY
	IF FOUND				 !  FOUND A NEW RECORD
	  SCROLL(ROW,COL,ROWS,COLS,-(ROWS(?POINT)))! SCROLL THE SCREEN DOWN
	  GET(TABLE,1)				 !  GET RECORD FROM TABLE
	  DO FILL_SCREEN			 !  DISPLAY ON SCREEN
	.

      OF PGUP_KEY				 !PAGE UP KEY
	DO SET_PREV				 !  POINT TO PREVIOUS RECORD
	DO PREV_PAGE				 !  DISPLAY THE PREVIOUS PAGE

      OF CTRL_PGUP				 !CTRL-PAGE UP
	DO FIRST_PAGE				 !  DISPLAY THE FIRST PAGE
	NDX = 1					 !  POSITION POINT BAR
  . . .
  FREE(TABLE)					 !FREE MEMORY TABLE

SAME_PAGE ROUTINE				 !DISPLAY THE SAME PAGE
  GET(TABLE,1)					 !  GET THE FIRST TABLE ENTRY
  DO FILL_RECORD				 !  FILL IN THE RECORD
  SET(com:por_codigo,com:por_codigo,TBL:PTR)	 !  POSITION FILE
  FREE(TABLE)					 !  EMPTY THE TABLE
  DO NEXT_PAGE					 !  DISPLAY A FULL PAGE

FIRST_PAGE ROUTINE				 !DISPLAY FIRST PAGE
  BLANK(ROW,COL,ROWS,COLS)
  FREE(TABLE)					 !  EMPTY THE TABLE
  CLEAR(com:RECORD,-1)				 !  CLEAR RECORD TO LOW VALUES
  CLEAR(TBL:PTR)				 !  ZERO RECORD POINTER
  SET(com:por_codigo)				 !  POINT TO FIRST RECORD
  LOOP NDX = 1 TO COUNT				 !  FILL UP THE TABLE
    DO FILL_NEXT				 !    FILL A TABLE ENTRY
    IF NOT FOUND THEN BREAK.			 !    GET OUT IF NO RECORD
  .
  NDX = 1					 !  SET TO TOP OF TABLE
  DO SHOW_PAGE					 !  DISPLAY THE PAGE

LAST_PAGE ROUTINE				 !DISPLAY LAST PAGE
  NDX# = NDX					 !  SAVE SELECTOR POSITION
  BLANK(ROW,COL,ROWS,COLS)			 !  CLEAR SCROLLING AREA
  FREE(TABLE)					 !  EMPTY THE TABLE
  CLEAR(com:RECORD,1)				 !  CLEAR RECORD TO HIGH VALUES
  CLEAR(TBL:PTR,1)				 !  CLEAR PTR TO HIGH VALUE
  SET(com:por_codigo)				 !  POINT TO FIRST RECORD
  LOOP NDX = COUNT TO 1 BY -1			 !  FILL UP THE TABLE
    DO FILL_PREV				 !    FILL A TABLE ENTRY
    IF NOT FOUND THEN BREAK.			 !    GET OUT IF NO RECORD
  .
  NDX = NDX#					 !  RESTORE SELECTOR POSITION
  DO SHOW_PAGE					 !  DISPLAY THE PAGE

FIND_RECORD ROUTINE				 !POSITION TO SPECIFIC RECORD
  SET(com:por_codigo,com:por_codigo,NEWPTR)	 !POSITION FILE
  IF NEWPTR = 0					 !NEWPTR NOT SET
    NEXT(company)				 !  READ NEXT RECORD
    NEWPTR = POINTER(company)			 !  SET NEWPTR
    SKIP(company,-1)				 !  BACK UP TO DISPLAY RECORD
  .
  FREE(TABLE)					 !  CLEAR THE RECORD
  DO NEXT_PAGE					 !  DISPLAY A PAGE

NEXT_PAGE ROUTINE				 !DISPLAY NEXT PAGE
  SAVECNT# = RECORDS(TABLE)			 !  SAVE RECORD COUNT
  LOOP COUNT TIMES				 !  FILL UP THE TABLE
    DO FILL_NEXT				 !    FILL A TABLE ENTRY
    IF NOT FOUND				 !    IF NONE ARE LEFT
      IF NOT SAVECNT#				 !	IF REBUILDING TABLE
	DO LAST_PAGE				 !	FILL IN RECORDS
	EXIT					 !	EXIT OUT OF ROUTINE
      .
      BREAK					 !    EXIT LOOP
  . .
  DO SHOW_PAGE					 !  DISPLAY THE PAGE

SET_NEXT ROUTINE				 !POINT TO THE NEXT PAGE
  GET(TABLE,RECORDS(TABLE))			 !  GET THE LAST TABLE ENTRY
  DO FILL_RECORD				 !  FILL IN THE RECORD
  SET(com:por_codigo,com:por_codigo,TBL:PTR)	 !  POSITION FILE
  NEXT(company)					 !  READ THE CURRENT RECORD

FILL_NEXT ROUTINE				 !FILL NEXT TABLE ENTRY
  FOUND = FALSE					 !  ASSUME RECORD NOT FOUND
  LOOP UNTIL EOF(company)			 !  LOOP UNTIL END OF FILE
    NEXT(company)				 !    READ THE NEXT RECORD
    FOUND = TRUE				 !    SET RECORD FOUND
    DO FILL_TABLE				 !    FILL IN THE TABLE ENTRY
    ADD(TABLE)					 !    ADD LAST TABLE ENTRY
    GET(TABLE,RECORDS(TABLE)-COUNT)		 !    GET ANY OVERFLOW RECORD
    DELETE(TABLE)				 !    AND DELETE IT
    EXIT					 !    RETURN TO CALLER
  .
PREV_PAGE ROUTINE				 !DISPLAY PREVIOUS PAGE
  LOOP COUNT TIMES				 !  FILL UP THE TABLE
    DO FILL_PREV				 !    FILL A TABLE ENTRY
    IF NOT FOUND THEN BREAK.			 !    GET OUT IF NO RECORD
  .
  DO SHOW_PAGE					 !  DISPLAY THE PAGE

SET_PREV ROUTINE				 !POINT TO PREVIOUS PAGE
  GET(TABLE,1)					 !  GET THE FIRST TABLE ENTRY
  DO FILL_RECORD				 !  FILL IN THE RECORD
  SET(com:por_codigo,com:por_codigo,TBL:PTR)	 !  POSITION FILE
  PREVIOUS(company)				 !  READ THE CURRENT RECORD

FILL_PREV ROUTINE				 !FILL PREVIOUS TABLE ENTRY
  FOUND = FALSE					 !  ASSUME RECORD NOT FOUND
  LOOP UNTIL BOF(company)			 !  LOOP UNTIL BEGINNING OF FILE
    PREVIOUS(company)				 !    READ THE PREVIOUS RECORD
    FOUND = TRUE				 !    SET RECORD FOUND
    DO FILL_TABLE				 !    FILL IN THE TABLE ENTRY
    ADD(TABLE,1)				 !    ADD FIRST TABLE ENTRY
    GET(TABLE,COUNT+1)				 !    GET ANY OVERFLOW RECORD
    DELETE(TABLE)				 !    AND DELETE IT
    EXIT					 !    RETURN TO CALLER
  .
SHOW_PAGE ROUTINE				 !DISPLAY THE PAGE
  NDX# = NDX					 !  SAVE SCREEN INDEX
  LOOP NDX = 1 TO RECORDS(TABLE)		 !  LOOP THRU THE TABLE
    GET(TABLE,NDX)				 !    GET A TABLE ENTRY
    DO FILL_SCREEN				 !    AND DISPLAY IT
    IF TBL:PTR = NEWPTR				 !    SET INDEX FOR NEW RECORD
      NDX# = NDX				 !    POINT TO CORRECT RECORD
  . .
  NDX = NDX#					 !  RESTORE SCREEN INDEX
  NEWPTR = 0					 !  CLEAR NEW RECORD POINTER
  CLEAR(com:RECORD)				 !  CLEAR RECORD AREA

FILL_TABLE ROUTINE				 !MOVE FILE TO TABLE
  TBL:cod_company = com:cod_company
  TBL:Nombre = com:Nombre
  TBL:PTR = POINTER(company)			 !  SAVE RECORD POINTER

FILL_RECORD ROUTINE				 !MOVE TABLE TO FILE
  com:cod_company = TBL:cod_company

FILL_SCREEN ROUTINE				 !MOVE TABLE TO SCREEN
  SCR:Nombre = TBL:Nombre

GET_RECORD ROUTINE				 !GET SELECTED RECORD
  GET(TABLE,NDX)				 !  GET TABLE ENTRY
  GET(company,TBL:PTR)				 !  GET THE RECORD




	     eject ('Fecha a Considerar')
Pedir_Fecha  PROCEDURE

SCREEN	     SCREEN	  PRE(SCR),window(6,26),at(6,28),hue(14,1)
	       row(1,1)	  string('ÉÍ{24}»')
	       row(2,1)	  repeat(4);STRING('º<0{24}>º') .
	       row(6,1)	  string('ÈÍ{24}¼')
	       row(2,5)	  string('Fecha a Considerar')
			  ENTRY,USE(?FIRST_FIELD)
	       row(4,9)	  entry(@d6),use(MEM:Fecha_W),num,ins
			  ENTRY,USE(?LAST_FIELD)
	     .

  EJECT
  CODE
  OPEN(SCREEN)					 !OPEN THE SCREEN
  SETCURSOR					 !TURN OFF ANY CURSOR
  mem:Fecha_W = today()				 !CALL SETUP PROCEDURE
  DISPLAY					 !DISPLAY THE FIELDS
  LOOP						 !LOOP THRU ALL THE FIELDS
    ALERT					 !RESET ALERTED KEYS
    ALERT(ACCEPT_KEY)				 !ALERT SCREEN ACCEPT KEY
    ALERT(REJECT_KEY)				 !ALERT SCREEN REJECT KEY
    alert(f4_key)
    alert(f5_key)
    alert(alt_f10)
    ACCEPT					 !READ A FIELD
    if keycode() = f4_key   ! calendario
      Calendario
      SELECT(?)			   ! SELECT THIS ENTRY
      CYCLE  ! ¨ hace falta esto ???
    .
    if keycode() = f5_key   ! control
      Control
      SELECT(?)		    ! SELECT THIS ENTRY
      CYCLE  ! ¨ hace falta esto ???
    .
    if keycode() = alt_f10	   ! ¨ Salir del sistema ?
      ConfSalida
      SELECT(?)			   ! SELECT THIS ENTRY
      CYCLE
    .
    IF KEYCODE() = REJECT_KEY THEN RETURN.	 !RETURN ON SCREEN REJECT KEY

    IF KEYCODE() = ACCEPT_KEY			 !ON SCREEN ACCEPT KEY
      UPDATE					 !  MOVE ALL FIELDS FROM SCREEN
      SELECT(?)					 !  START WITH CURRENT FIELD
      SELECT					 !  EDIT ALL FIELDS
      CYCLE					 !  GO TO TOP OF LOOP
    .						 !

    CASE FIELD()				 !JUMP TO FIELD EDIT ROUTINE
    OF ?FIRST_FIELD				 !FROM THE FIRST FIELD
      IF KEYCODE() = ESC_KEY THEN RETURN.	 !  RETURN ON ESC KEY

    OF ?LAST_FIELD				 !FROM THE LAST FIELD
      IF ACTION <> 3				 !IF THIS IS NOT A DELETE
	ACTION = 2				 !  SET ACTION TO CHANGE MODE
	prestaciones				 !  CALL NEXT FORM PROCEDURE
	IF ACTION				 !  IF RECORD WAS NOT CHANGED
	  SELECT(?LAST_FIELD - 1)		 !    SELECT THE LAST ENTRY
	  CYCLE					 !    AND LOOP AGAIN
      . .
      ACTION = 0				 !  SET ACTION TO COMPLETE
      RETURN					 !  AND RETURN TO CALLER
  . .

	     eject ('Prestaciones Sociales')
Prestaciones PROCEDURE
Salvar	     Screen	  Window(25,80),Hue(7,0)
	     .
Confirma     Screen	  Window(5,39),At(11,21),Hue(15,4)
	       Row(1,1)	  String('ÉÍ{37}»')
	       Row(2,1)	  Repeat(3);String('º<0{37}>º') .
	       Row(5,1)	  String('ÈÍ{37}¼')
	       Row(2,7)	  String('Pulse [ENTER] para imprimir')
	       Row(4,11)  String('o [ESC] para abortar')
	     .
Abortar	     Screen	  Window(5,39),At(11,21),Hue(15,4)
	       Row(1,1)	  String('ÉÍ{37}»')
	       Row(2,1)	  Repeat(3);String('º<0{37}>º') .
	       Row(5,1)	  String('ÈÍ{37}¼')
	       Row(3,5)	  String('Pulse [CTRL] [ESC] para abortar')
	     .
TITLE	     report	  length(58),width(215),pre(TTL),device(MEM:DEVICE)
RPT_HEAD		  detail
	     .		  .
REPORT	     report	  length(58),width(216),page(MEM:PAGE),line(MEM:LINE),pre(RPT),device(MEM:DEVICE)
PAGE_HEAD		  header
		 col(1)	    ctl('<15>') string('Compa¤¡a :')
Nombre_Cia	 col(12)    string(30)
Fecha_Rep	 col(206)   string(@D6)
	       row(+1,1)    string('Prestaciones Sociales al')
		 col(26)    string(@D6),use(MEM:Fecha_W)
Hora_rep	 col(208)   string(@T4)
	       row(+1,1)    string('Cod   Nombre {26}Fecha  de Tiempo de trabajo    Salario   Salario   Utilidades {9}Vac. Vencidas  Vac. Fraccionadas   Indemnizaci¢n    Total mes {8}Total  Diferencia   ³ '	     |
			      & 'Preaviso')
	       row(+1,39)   string('ingreso    A¤os Meses Dias {5}Mensual   Diario    Dias {6}Monto    Dias {5}Monto Dias {8}Monto   Dias    Monto    anterior {9}hoy {17}³ Dias {6}Monto') ctl(@LF)
			  .
GRP_HEAD1		  detail
		 col(1)	    string('Secci¢n:')
Descripcion	 col(10)    string(20)
		 col(198)   string('³') ctl(@LF)
			  .
DETAIL			  detail
		 col(1)	    string(@N3),use(Emp:cod_empleado)
		 col(7)	    string(30),use(Emp:nombre)
		 col(38)    string(@D6),use(Emp:f_ingreso)
anos		 col(51)    string(@p##p)
meses		 col(56)    string(@p##p)
dias		 col(62)    string(@p##p)
S_mes		 col(67)    string(@N10`2)
S_dia		 col(78)    string(@N9`2)
Util		 col(90)    string(@N5`2)
uti		 col(96)    string(@N10`2)
		 col(114)   string(@N9`2),use(Emp:Vacaciones)
Vac		 col(124)   string(@N5`2)
va		 col(131)   string(@N10`2)
Anti		 col(143)   string(@N3)
an		 col(147)   string(@N10`2)
Monto		 col(160)   string(@N10`2)
Total		 col(173)   string(@N10`2)
Diferencia	 col(185)   string(@N(12`2))
		 col(198)   string('³')
Prev		 col(201)   string(@N3)
pr		 col(206)   string(@N10`2) ctl(@LF)
			  .
GRP_FOOT1		  detail
			  .
RPT_FOOT		  detail
		 col(1)	    string('ÚÄ{196}ÅÄ{17}¿')
	       row(+1,1)    string('³Totales:')
T_uti		 col(94)    string(@N12`2)
T_Vacaciones	 col(111)   string(@N12`2)
T_va		 col(129)   string(@N12`2)
T_an		 col(145)   string(@N12`2)
T_Total		 col(160)   string(@N12`2)
		 col(198)   string('³')
T_pr		 col(204)   string(@N12`2)
		 col(216)   string('³')
	       row(+1,1)    string('ÀÄ{196}ÁÄ{17}Ù') ctl(@LF)
			  .
PAGE_FOOT		  footer
		 col(1)	    ctl('<18>') ctl(@LF)
			    ctl(@FF)
	     .		  .
	     GROUP,PRE(SAV)
Cod_seccion    byte
cod_company    byte
	     .
  code
  open(Confirma)
  loop until keycode() = enter_key
    ask
    IF KEYCODE() = REJECT_KEY or KEYCODE() = esc_KEY
       THEN RETURN.				   !RETURN ON SCREEN REJECT KEY
  .
  close(confirma)
  open(Abortar)
  if upper(clip(mem:Device)) = 'CON' then open(Salvar).

  DONE# = 0					 !TURN OFF DONE FLAG

  SAV:cod_company = Emp:cod_company		 !SAVE SELECTOR FIELD
  CLEAR(Emp:RECORD,-1)				 !MAKE SURE RECORD CLEARED
  Emp:cod_company = SAV:cod_company		 !RESTORE SELECTOR FIELD
  RPT:T_uti = 0
  RPT:T_Vacaciones = 0
  RPT:T_va = 0
  RPT:T_an = 0
  RPT:T_Total = 0
  RPT:T_pr = 0
  PRINT(TTL:RPT_HEAD)				 !PRINT TITLE PAGE
  CLOSE(TITLE)					 !CLOSE TITLE REPORT
  SET(Emp:por_codigos,Emp:por_codigos)		 !SET TO FIRST SELECTED RECORD
  DO NEXT_RECORD				 !READ FIRST RECORD
  Com:cod_company = MEM:Cod_company		 !MOVE RELATED KEY FIELDS
  GET(Company,Com:por_codigo)			 !READ THE RECORD
  IF ERROR() THEN CLEAR(Com:RECORD).		 !IF NOT FOUND, CLEAR RECORD
  RPT:Nombre_Cia = Com:Nombre			 !DISPLAY LOOKUP FIELD
  RPT:Fecha_Rep = today()
  RPT:Hora_rep = clock()
  APPEND# = FALSE				 !TURN OFF APPEND FLAG
  IF SUB(MEM:DEVICE,1,1) <> '+'			 !NOT ALREADY APPENDING REPORTS
    MEM:DEVICE = '+' & MEM:DEVICE		 !  APPEND DISK RPT TO TITLE
    APPEND# = TRUE				 !  SET FLAG TO TURN OFF APPEND
  .
  OPEN(REPORT)					 !OPEN THE REPORT
  BRK_FLAG# = 0					 !CLEAR BREAK LEVEL FLAG
  DO PRT_BRK_HDRS				 !PRINT GROUP HEADER(S)
  LOOP UNTIL DONE#				 !READ ALL RECORDS IN FILE
    SAVE_LINE# = MEM:LINE			 !  SAVE LINE NUMBER
    LAST_REC# = POINTER(Empleado)
    PRINT(RPT:DETAIL)				 !  PRINT DETAIL LINES
    DO CHECK_PAGE				 !  DO PAGE BREAK IF NEEDED
    RPT:T_uti += RPT:uti
    RPT:T_Vacaciones += Emp:Vacaciones
    RPT:T_va += RPT:va
    RPT:T_an += RPT:an
    RPT:T_Total += RPT:Total
    RPT:T_pr += RPT:pr
    DO NEXT_RECORD				 !  GET NEXT RECORD
    Com:cod_company = MEM:Cod_company		 !MOVE RELATED KEY FIELDS
    GET(Company,Com:por_codigo)			 !READ THE RECORD
    IF ERROR() THEN CLEAR(Com:RECORD).		 !IF NOT FOUND, CLEAR RECORD
    RPT:Nombre_Cia = Com:Nombre			 !DISPLAY LOOKUP FIELD
    RPT:Fecha_Rep = today()
    RPT:Hora_rep = clock()
    IF NOT DONE# THEN DO CHECK_BREAK.		 !  CHECK FOR GROUP BREAK
  .						 !
  BRK_FLAG# = 0					 !CLEAR BREAK LEVEL FLAG
  DO PRT_BRK_FTRS				 !PRINT GROUP FOOTER(S)
  PRINT(RPT:RPT_FOOT)				 !PRINT GRAND TOTALS
  DO CHECK_PAGE					 !  DO PAGE BREAK IF NEEDED
  CLOSE(REPORT)					 !CLOSE REPORT
  IF APPEND#					 !IF REPORT WAS APPENDED
    MEM:DEVICE = SUB(MEM:DEVICE,2,LEN(MEM:DEVICE)-1)!TURN OFF APPEND REPORT
  .
  RETURN					 !RETURN TO CALLER

NEXT_RECORD ROUTINE				 !GET NEXT RECORD
  LOOP UNTIL EOF(Empleado)			 !  READ UNTIL END OF FILE
    NEXT(Empleado)				 !    READ NEXT RECORD
    if (emp:Activo) = 'I' then cycle.
    IF Emp:cod_company <> SAV:cod_company	 !IF END OF SELECTION
       Emp:cod_company = SAV:cod_company	 !  RESTORE THE SELECTOR
       BREAK					 !  AND BREAK
    .
    RPT:anos = Intervalo('A', emp:f_ingreso, mem:Fecha_W)
    RPT:meses = Intervalo('M', emp:f_ingreso, mem:Fecha_W)
    RPT:dias = Intervalo('D', emp:f_ingreso, mem:Fecha_W)
    IF emp:tipo_salario = 'M'			 !EVALUATE CONDITION
      RPT:S_mes = emp:sueldo_act		 !  CONDITION IS TRUE
    ELSE					 !OTHERWISE
      RPT:S_mes = emp:sueldo_act * 30		 !  CONDITION IS FALSE
    .
    IF emp:tipo_salario = 'M'			 !EVALUATE CONDITION
      RPT:S_dia = emp:sueldo_act / 30		 !  CONDITION IS TRUE
    ELSE					 !OTHERWISE
      RPT:S_dia = emp:sueldo_act		 !  CONDITION IS FALSE
    .
    RPT:Util = Util()
    RPT:uti = rpt:Util * rpt:S_dia
    RPT:Vac = Vac()
    RPT:va = rpt:vac * rpt:S_dia
    RPT:Anti = Anti()
    RPT:an = rpt:anti * rpt:S_dia
    RPT:Monto = emp:Monto_pr			    !DISPLAY LOOKUP FIELD
    RPT:Total = rpt:S_dia * (rpt:anti+rpt:vac+rpt:util)
    emp:Monto_pr_2 = RPT:Total
    put(Empleado)
    RPT:Diferencia = rpt:Total - rpt:Monto
    RPT:Prev = Prev()
    RPT:pr = rpt:prev * rpt:S_dia
    IF ~(Emp:f_ingreso < Fecha_W and emp:status <> 'I') THEN CYCLE.!IF FILTERED OUT, GET NEXT
    EXIT					 !    EXIT THE ROUTINE
  .						 !
  DONE# = 1					 !  ON EOF, SET DONE FLAG

CHECK_PAGE ROUTINE				 !CHECK FOR NEW PAGE
  IF MEM:LINE <= SAVE_LINE#			 !  ON PAGE OVERFLOW
    SAVE_LINE# = MEM:LINE			 !    RESET LINE NUMBER
  .
  LOOP UNTIL NOT KEYBOARD()			 !LOOK FOR KEYSTROKE
    ASK
    IF KEYCODE() = REJECT_KEY			 !ON CTRL-ESC
      IF APPEND#				 !IF REPORT WAS APPENDED
	MEM:DEVICE = SUB(MEM:DEVICE,2,LEN(MEM:DEVICE)-1)!TURN OFF APPEND REPORT
      .
      CLOSE(REPORT)				 !  CLOSE REPORT
      RETURN					 !  ABORT PRINT
  . .

CHECK_BREAK  ROUTINE				 !CHECK FOR GROUP BREAK
  IF Emp:Cod_seccion <> SAV:Cod_seccion		 !BREAK ON NEW GROUP
    BRK_FLAG# = 1				 !SET BREAK LEVEL
    DO PRT_BRK_FTRS				 !PRINT FOOTERS FOR THIS LEVEL
    DO PRT_BRK_HDRS				 !PRINT HEADERS FOR THIS LEVEL
    EXIT					 !RETURN TO REPORT
  .

PRT_BRK_HDRS ROUTINE				 !DO GROUP HEADERS
  IF BRK_FLAG# <= 1				 !CHECK BREAK LEVEL
    Sec:Codigo = Emp:Cod_seccion		 !MOVE RELATED KEY FIELDS
    GET(Seccion,Sec:Por_Codigo)			 !READ THE RECORD
    IF ERROR() THEN CLEAR(Sec:RECORD).		 !IF NOT FOUND, CLEAR RECORD
    RPT:Descripcion = Sec:Descripcion		 !DISPLAY LOOKUP FIELD
    PRINT(GRP_HEAD1)				 ! PRINT GROUP HEADER
    DO CHECK_PAGE				 ! DO PAGE BREAK IF NEEDED
  .
  SAV:Cod_seccion = Emp:Cod_seccion		 !SAVE BREAK FIELD

PRT_BRK_FTRS ROUTINE				 !DO GROUP FOOTERS
  GET(Empleado,LAST_REC#)			 !REREAD PREVIOUS RECORD
  IF BRK_FLAG# <= 1				 !CHECK BREAK LEVEL
    PRINT(GRP_FOOT1)				 ! PRINT GROUP FOOTER
    DO CHECK_PAGE				 ! DO PAGE BREAK IF NEEDED
  .
  SKIP(Empleado,-1)				 !BACKUP ONE RECORD
  NEXT(Empleado)				 !AND REREAD IT

