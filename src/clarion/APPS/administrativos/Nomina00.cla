Seleccion    procedure
  code
    com:cod_company = mem:cod_company	   !Preparar los archivos
    emp:cod_company = mem:cod_company
    nom:cod_company = mem:cod_company	   ! para LOOKUP y RECORD SELECTOR
    nom:semana	    = mem:semana	   ! para LOOKUP y RECORD SELECTOR
  nom:semana	    = 1
    nom:tipo	    = mem:tipo_nomina
    emp:tipo	    = mem:tipo_nomina
    SET(com:por_codigo)			   !	POSITION TO CLOSEST RECORD
    get(company, com:por_codigo)
    ctr:cod_company = com:cod_company	   ! Leer el registro de control
    ctr:semana = 1 ! com:nom_actual
    SET(emp:por_company)		   !	POSITION TO CLOSEST RECORD
    SET(nom:por_company)		   !	POSITION TO CLOSEST RECORD



Set_Nom	     procedure
  Code
  ! Prepara datos basicos de la nomina a generar
  ! ??? Esto debe estar el la rutina que selecciona compa¤¡a
  return
    com:cod_company = mem:cod_company
    get(company, com:por_codigo)
    mem:semana = com:nom_actual !+ 1
    ctr:cod_company = mem:cod_company
    ctr:semana = 1 !com:nom_actual
    get(ctrl_nom, por_semana)
    if mem:tipo_nomina = 'O'
      mem:f_desde = ctr:f_desde + 7
      mem:f_hasta = ctr:f_hasta + 7
      mem:f_pago  = ctr:f_pago + 7
    else
      mem:f_desde_q = ctr:f_desde_q + 15
      mem:f_hasta_q = ctr:f_hasta_q + 15
      mem:f_pago_q = ctr:f_pago_q + 15
    .

Genera_nom   procedure
  Code
  ! Generar registros de nomina
    SET(empleado)			   !Ir al primer registro
    loop until(eof(empleado))		   ! ??? revisar esto: hacer el acceso por clave
      next(empleado)
      if emp:cod_company <> mem:cod_company then cycle.
      if emp:tipo	 <> mem:tipo_nomina then cycle.
      if emp:Activo = 'I' then cycle.
      if emp:Activo = 'V' then		   ! Esta de vacaciones
	do Nom_Vacacion
      elsif emp:Status <> 'N'		   ! Ha sido modificado o es nuevo
	do Nom_original
      else
	nom:cod_company	  =   mem:cod_company
	nom:Semana	  =   mem:semana -1 !- 1 Esto es lo que causa la generaci¢n original
	nom:cod_empleado  =   emp:cod_empleado
	nom:Cod_Seccion	  =   emp:Cod_seccion
	! set(nomina, nom:Por_Company)
	get(nomina, nom:Por_Company)
	if Error() then
 !	   beep
 !	SHOW(25,1,CENTER(error(),80))
	  do Nom_original
	else
	  nom:Semana	    =	mem:semana !+1 o mejor com:nom_actual
	! put(nomina)
	.
      .
	add(nomina)
    .

	     ! Generar registro de control de nomina
    ctr:cod_company	=   mem:cod_company
    ctr:Semana		=   mem:semana
    ctr:f_desde		=   mem:f_desde
    ctr:f_hasta		=   mem:f_hasta
    ctr:f_pago		=   mem:f_pago
    ctr:f_desde_q	=   mem:f_desde_q
    ctr:f_hasta_q	=   mem:f_hasta_q
    ctr:f_pago_q	=   mem:f_pago_q
    ctr:cerrada		=   'N'
    put(ctrl_nom)
    if error() then add(ctrl_nom).
	     ! Actualizar registro de compa¤¡a
    com:cod_company = mem:cod_company
    get(company, com:por_codigo)
    com:nom_actual = mem:semana
    put(company)


Nom_Original Routine
	nom:cod_company	  =   mem:cod_company
	nom:Semana	  =   mem:semana
	nom:cod_empleado  =   emp:cod_empleado
	nom:Cod_Seccion	  =   emp:Cod_seccion
	nom:Tipo	  =   emp:tipo
	nom:Sal_base	  =   emp:sueldo_act
	nom:Dias_trabajo  =   8
	if emp:tipo = 'O' then
	   nom:Sal_Ord	     =	 nom:sal_base*nom:dias_trabajo
	else
	   nom:Sal_Ord	     =	 nom:sal_base / 2
	.
	nom:H_E_dia	  =   0
	nom:H_E_noche	  =   0
	nom:Desc_ingreso  =   ''
	nom:Monto_ingres  =   0
	Calc_Deds			     ! Calcula las deducciones
	if emp:Saldo_prest < emp:prestamo then
	  emp:prestamo	  =   emp:Saldo_prest
	.
	nom:Desc_Egreso	  =   ''
	nom:Monto_Egreso  =   0
	emp:Status	  =  'N'
	put(empleado)

Nom_Vacacion Routine
	nom:cod_company	  =   mem:cod_company
	nom:Semana	  =   mem:semana
	nom:cod_empleado  =   emp:cod_empleado
	nom:Cod_Seccion	  =   emp:Cod_seccion
	nom:Tipo	  =   emp:tipo
	nom:Sal_base	  =   emp:sueldo_act
	nom:Dias_trabajo  =   0
	nom:Sal_Ord	  =   0
	nom:H_E_dia	  =   0
	nom:H_E_noche	  =   0
	nom:Desc_ingreso  =   ''
	nom:Monto_ingres  =   0
	nom:Polit_habit	  =   0
	nom:S_S_O	  =   0
	nom:Paro_forzoso =    0
	nom:I_S_R	  =   0
	nom:prestamo	  =   0
	nom:Desc_Egreso	  =   ''
	nom:Monto_Egreso  =   0
	emp:Status	  =  'N'
	put(empleado)

Calc_Deds   Procedure
  ! Calculo de deducciones en el mapa de modificacion de nomina
factor	    byte

  Code
  if	emp:Tipo_Pago = 'S'
    factor = 4
  elsif emp:Tipo_Pago = 'Q'
    factor = 2
  else	emp:Tipo_Pago = 'M'
    factor = 1
  .

  emp:Polit_habit   =	0.01*emp:sal_Ord

  if	emp:Sal_Ord < 6000 / factor
    emp:S_S_O	    =	0
    emp:Paro_forzoso =	0
  elsif emp:Sal_Ord > 15000 / factor
    if emp:tipo = 'E' then
      emp:S_S_O	       =  600 / factor
      emp:Paro_forzoso =  37.50 / factor
    else
      emp:S_S_O	       =  300 / factor
      emp:Paro_forzoso =  37.50 / factor
    .
  else
    if emp:tipo = 'E' then
      emp:S_S_O	     =	emp:Sal_Ord * 0.04
    else
      emp:S_S_O	     =	emp:Sal_Ord * 0.02
    .
    emp:Paro_forzoso =	emp:Sal_Ord * 0.0025
  .


Cierra_Nom   PROCEDURE
  ! Cierre de una nomina
  ! debe Hacerse despues de emitir los reportes
  ! pero antes de emitir el reporte al banco
T_dev	 real
T_ded	 real
  Code

 ! Esto se debe eliminar al destapar el resto del codigo
    emp:cod_company  = mem:cod_company
    emp:cod_empleado = 0
    set(emp:por_company)
    loop until eof(empleado)
      next(empleado)
      if emp:cod_company <> mem:cod_company then cycle. ! Ruptura
      if emp:tipo <> mem:tipo_nomina then cycle.
      emp:saldo_prest -= emp:prestamo
      T_dev = emp:sal_ord+emp:transporte+emp:alimentacion+emp:monto_ingres
      t_ded = emp:polit_habit+emp:s_s_o+emp:Paro_forzoso+emp:i_s_r+emp:prestamo+emp:monto_egreso
      emp:Total_Pagado = round(T_dev - T_ded,1)
      put(empleado)
    .
   return
 ! Eliminar hasta aqui



 OMIT('**-END-**')
					   !Preparar los archivos
    ctr:cod_company = mem:cod_company	   ! Leer el registro de control
    ctr:semana = mem:semana
    get(ctrl_nom,por_semana)
    if ctr:cerrada = 'S' then return.	   ! Ya esta cerrada

    nom:cod_company  = ctr:cod_company
    nom:semana	     = ctr:semana
    nom:cod_empleado = 0
    SET(nom:por_company)
	   !
	   !	Begin Transaction
	   !
    loop until eof(nomina)
      next(nomina)
      if nom:cod_company <> ctr:cod_company then break.	   ! Ruptura

      emp:cod_company  = nom:cod_company		   ! Actualizar Empleado
      emp:cod_empleado = nom:cod_empleado
      get(empleado,emp:por_company)
      emp:prestamo -= nom:prestamo
      emp:Total_Pagado = 100
      put(empleado)
    .
    com:cod_company  = ctr:cod_company			 ! Actualizar Compa¤¡a
    get(company,com:por_codigo)
    com:nom_actual = ctr:semana + 1			 !Listos para la proxima semana
    mem:semana	   = ctr:semana + 1
    put(company)
    ctr:cerrada = 'S'
    put(ctrl_nom)
**-END-**
	   !
	   !	End Transaction
	   !


Prev	     Function
  ! Retorna el numero de dias de preaviso que corresponden a un empleado
  ! segun la ley
Meses	     short	  !numero de meses trabajados
Anos	     short	  !numero de a¤os trabajados
  code

  if emp:f_egreso = 0
     meses = Intervalo('M', mem:fecha_W, emp:f_ingreso)
     anos  = Intervalo('A', mem:fecha_W, emp:f_ingreso)
  else
     meses = Intervalo('M', emp:f_egreso, emp:f_ingreso)
     anos  = Intervalo('A', emp:f_egreso, emp:f_ingreso)
  .
  meses = meses + 12 * anos
  if	meses = 0
	  return(0)
  elsif meses < 6
	  return(7)
  elsif meses < 12
	  return(15)
  elsif meses < 60
	  return(30)
  else
	  return(60)
  .


Anti	     Function
  ! Retorna el numero de dias de antigedad que corresponden a un empleado
  ! segun la ley
Meses	     short	  !numero de meses trabajados
  code

  if emp:f_egreso = 0
     meses = Intervalo('M', mem:fecha_W, emp:f_ingreso) + 12 * Intervalo('A', mem:fecha_W, emp:f_ingreso)
  else
     meses = Intervalo('M', emp:f_egreso, emp:f_ingreso)+ 12 * Intervalo('M', emp:f_egreso, emp:f_ingreso)
  .
  if	meses < 3
	  return(0)
  elsif meses < 6
	  return(10)
  elsif meses < 18
	  return(30)
  elsif meses < 30
	  return(60)
  elsif meses < 42
	  return(90)
  elsif meses < 54
	  return(120)
  else
	  return(150)
  .


Vac	     Function
  ! Retorna el numero de dias de vacaciones que corresponden a un empleado
  ! segun la ley
Anos	     short	  !numero de a¤os trabajados
Meses	     short	  !numero de meses trabajados

  code
  if emp:f_egreso = 0
     meses = Intervalo('M', mem:fecha_W, emp:f_ingreso)
     anos = Intervalo('A', mem:fecha_W, emp:f_ingreso)
  else
     meses = Intervalo('M', emp:f_egreso, emp:f_ingreso)
     anos = Intervalo('A', emp:f_egreso, emp:f_ingreso)
  .
  if anos > 0 and meses = 0		 ! A¤o exacto
     if anos < 8
	return(15 + anos - 1)
     else
	return(21)
     .
  else
     return(meses)
  .

Util	     Function
  ! Retorna el numero de dias de utilidades que corresponden a un empleado
  ! (7.5 dias por mes completo trabajado)
Meses	     short	  !numero de meses trabajados
  code
  if year(emp:f_ingreso) = year(mem:fecha_W)
     meses = Intervalo('M', mem:fecha_W, emp:f_ingreso)
  else
   ! meses = Intervalo('M', mem:fecha_W, date(01,01,year(mem:fecha_W)))
     meses = month(mem:fecha_W)
  .
  if com:Tipo = 'U'		! compa¤¡a urbana
     return(7.5 * meses)
  else
     return(3.75 * meses)
  .


Intervalo    Function(tipo, fecha_1, fecha_2)
  ! Calcula la cantidad de a¤os, meses o dia completos entre dos fechas
tipo	     string(1)
fecha_1	     long
fecha_2	     long
fecha_tmp    long
d1	     short
m1	     short
a1	     short
d2	     short
m2	     short
a2	     short
  code
     if fecha_1 < fecha_2 then
       fecha_tmp = fecha_1
       fecha_1	 = fecha_2
       fecha_2	 = fecha_tmp
     .
     fecha_1  += 1
  d1 = day(fecha_1)
  m1 = month(fecha_1)
  a1 = year(fecha_1)
  d2 = day(fecha_2)
  m2 = month(fecha_2)
  a2 = year(fecha_2)
  if d1 < d2
     d1 += 30
     m1 -=  1
  .
  if m1 < m2
     m1 += 12
     a1 -= 1
  .
  case tipo
    of 'A'
      return (a1 - a2)
    of 'M'
      return (m1 - m2)
    of 'D'
      return (d1 - d2)
  .

SEL_COMPANY  PROCEDURE

