 OMIT('**-END-**')
	     วฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤถ
	     บþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþþบ
	     ศออออออออออออออออออออออออออออออออออออออออออออออออออออผ
**-END-**

	       ROW(1,1)	  STRING('วฤ{52}ถ'),ENH
	       ROW(2,1)	  STRING('บ<0{52}>บ'),ENH
	       ROW(3,1)	  STRING('ศอ{52}ผ'),ENH
ERRMESS	       ROW(2,2)	  STRING(52),REV,BLK
	     .

DIRGRP	     GROUP,PRE(GRP)
DIRREC	       GROUP
		 BYTE,DIM(21)			 !USED BY NEXTDIR
ATTRIB		 BYTE				 !FILE ATTRIBUTE IN DOS FORMAT
TIME		 SHORT				 !FILE TIME IN DOS FORMAT
DATE		 SHORT				 !FILE DATE IN DOS FORMAT
FILESIZE	 LONG				 !FILE SIZE IN BYTES
NAME		 STRING(13)			 !FILENAME
PORS		 STRING(9)			 !PREVIOUS OR SUBDIRECTORY
	     . .

DIRTBL	     TABLE,PRE(TBL)
DIRREC	       GROUP
		 BYTE,DIM(21)			 !USED BY NEXTDIR
ATTRIB		 BYTE				 !FILE ATTRIBUTE IN DOS FORMAT
TIME		 SHORT				 !FILE TIME IN DOS FORMAT
DATE		 SHORT				 !FILE DATE IN DOS FORMAT
FILESIZE	 LONG				 !FILE SIZE IN BYTES
NAME		 STRING(10)			 !FILENAME
EXT		 STRING(3)			 !FILE EXTENSION
PORS		 STRING(9)			 !PREVIOUS OR SUBDIRECTORY
	     . .

SORTTBL	     TABLE,PRE(SRT)			 !SORT TABLE
TBLREC	       BYTE				 !  TABLE RECORD
SORTSTR	       STRING(30)			 !  SORT STRING
	     .

SCROLL_GRP   GROUP				 !SCROLL PROCEDURE PARAMETERS
FLD	       BYTE(?POINT)			 !  FIELD NUMBER OF ?POINT
PTR	       LONG				 !  POINTER() OF TOP RECORD
NEW_PTR	       LONG				 !  POINTER() OF INSERTED RECORD
NDX	       BYTE				 !  REPEAT INDEX
FIRST_NDX      BYTE				 !  FIRST ROW TO BE DISPLAYED
LAST_NDX       BYTE				 !  LAST ROW TO BE DISPLAYED
ROWS	       BYTE(15)				 !  NUMBER OF ROWS TO SCROLL
COLS	       BYTE(52)				 !  NUMBER OF COLUMNS TO SCROLL
RECS	       LONG				 !  RECORDS() IN FILE
	     .
SAVE_NDX     BYTE				 !SAVE AREA FOR REPEAT INDEX


  CODE
  OPEN(DSCREEN)					 !OPEN DIRECTORY SCREEN
  DO GET_FILES					 !LOAD DIRECTORY FILES IN MEMORY
						 ! TABLE
  LOOP						 !LOOP THRU SCREEN
    DO SHOW_FILES				 !DISPLAY FILES ON SCREEN

    ALERT()					 !CLEAR ALERT KEYS
    ALERT(CTRL_M)				 !ALERT CONTROL-M KEY
    ALERT(CTRL_S)				 !ALERT CONTROL-S KEY
    ALERT(CTRL_R)				 !ALERT CONTROL-R KEY
    ALERT(CTRL_G)				 !ALERT CONTROL-G KEY
    ALERT(CTRL_X)				 !ALERT CONTROL-X KEY
    ALERT(ESC_KEY)				 !ALERT ESCAPE KEY
    ACCEPT					 !ACCEPT A FIELD

    CASE KEYCODE()				 !CHECK FOR KEY PRESSED
    OF ESC_KEY					 !IF ESC KEY
      RETURN					 !  RETURN TO MAIN MENU
    OF CTRL_G					 !IF CTRL-G  (GO TO DIRECTORY)
      GET(DIRTBL,PTR+NDX-1)			 !  GET ENTRY FROM TABLE
      IF TBL:PORS = '<<SUB DIR>'                 !  IF IT'S A SUBDIRECTORY
	IF ROOT" = 'NO'                          !    IF WE'RE NOT IN ROOT
	  DIR" = PATH() & TBL:NAME		 !	ASSIGN NEW DIRECTORY
	ELSE					 !    OTHERWISE
!          DIR" = PATH() & SUB(TBL:NAME,2,LEN(TBL:NAME)) !ASSIGN NEW DIRECTORY
          DIR" = 'a:\'
	.
	SETPATH(DIR")				 !	CHANGE TO NEW DIRECTORY
	IF ERROR()				 !  IF THERE WAS AN ERROR
	  DO ERROR_RTN				 !    DISPLAY ERROR MESSAGE
	.					 !  END IF
	DO GET_FILES				 !	REDISPLAY SCREEN
      ELSIF TBL:PORS = '<<PRE DIR>'		 !  OTHERWISE (PREVIOUS DIR)
	DIR" = PATH() & '\..'			 !    ASSIGN NEW DIRECTORY
	SETPATH(DIR")				 !    CHANGE TO NEW DIRECTORY
	IF ERROR()				 !  IF THERE WAS AN ERROR
	  DO ERROR_RTN				 !    DISPLAY ERROR MESSAGE
	  CYCLE
	.					 !  END IF
	DO GET_FILES				 !    REDISPLAY SCREEN
      ELSE					 !  OTHERWISE
	BEEP					 !    GIVE ERROR BEEP
	CYCLE					 !    AND TRY AGAIN
      .						 !  END IF

    OF CTRL_X					 !  IF CONTROL-X (DOS SHELL)
      OPEN(RUNWIN)				 !    OPEN RUN WINDOW
      RUNIT" = ''
      ALERT()					 !  CLEAR ALERT KEYS
      ALERT(ESC_KEY)				 !  ALERT THE ESC KEY
      ACCEPT					 !    ACCEPT THE FIELD
      CLOSE(RUNWIN)				 !    CLOSE RUN WINDOW
      IF KEYCODE() = ESC_KEY			 !    IF ESC PRESSED
	CYCLE					 !	START AGAIN
      .						 !    END IF
      RUN(RUNIT")				 !    RUN THE DOS COMMAND
      OPEN(DSCREEN)
      DO GET_FILES				 !    REDISPLAY SCREEN

    OF CTRL_M					 !  IF CTRL-M (CREATE DIRECTORY)
      SHOW(22,14,'')				 !    POSITION DIR WINDOW
      OPEN(DIRWIN)				 !    OPEN DIR NAME WINDOW
      MRDIR" = ''				 !    CLEAR PREVIOUS DATA
      ALERT()					 !  CLEAR ALERT KEYS
      ALERT(ESC_KEY)				 !  ALERT THE ESC KEY
      ACCEPT					 !    ACCEPT A NAME
      IF KEYCODE() = ESC_KEY			 !    IF CTRL-ESC PRESSED
	CLOSE(DIRWIN)				 !	CLOSE DIR WINDOW
	CYCLE					 !	AND START AGAIN
      .						 !    END IF
      CLOSE(DIRWIN)				 !    CLOSE DIR WINDOW
      MAKEDIR(MRDIR")				 !    MAKE THE NEW DIRECTORY
      IF ERROR()				 !  IF THERE WAS AN ERROR
	DO ERROR_RTN				 !    DISPLAY ERROR MESSAGE
	CYCLE
      .						 !  END IF
      DO GET_FILES				 !    REDISPLAY SCREEN

    OF CTRL_R					 !  IF CTRL-R (REMOVE DIRECTORY)
      SHOW(22,14,'')				 !    POSITION DIR WINDOW
      OPEN(DIRWIN)				 !    OPEN DIR NAME WINDOW
      MRDIR" = ''				 !    CLEAR PREVIOUS DATA
      ALERT()					 !  CLEAR ALERT KEYS
      ALERT(ESC_KEY)				 !  ALERT THE ESC KEY
      ACCEPT					 !    ACCEPT A NAME
      IF KEYCODE() = ESC_KEY			 !    IF CTRL-ESC PRESSED
	CLOSE(DIRWIN)				 !	CLOSE DIR WINDOW
	CYCLE					 !	AND START AGAIN
      .						 !    END IF
      CLOSE(DIRWIN)				 !    CLOSE DIR WINDOW
      REMOVEDIR(MRDIR")				 !    REMOVE THE NEW DIRECTORY
      IF ERROR()				 !  IF THERE WAS AN ERROR
	DO ERROR_RTN				 !    DISPLAY ERROR MESSAGE
	CYCLE
      .						 !  END IF
      DO GET_FILES				 !    REDISPLAY SCREEN

    OF CTRL_S					 !  IF CTRL-S (SORT OPTIONS)
      OPEN(SORTWIN)				 !    OPEN SORT WINDOW
      ALERT()					 !  CLEAR ALERT KEYS
      ALERT(ESC_KEY)				 !  ALERT THE ESC KEY
      ACCEPT					 !    ACCEPT THE FIELD
      IF KEYCODE() = ESC_KEY			 !    IF CTRL-ESC PRESSED
	CLOSE(SORTWIN)				 !	CLOSE SORT WINDOW
	CYCLE
      .						 !    END IF
      CLOSE(SORTWIN)				 !    CLOSE SORT WINDOW
      EXECUTE CHOICE()				 !    EXECUTE MENU CHOICE
	SORT(DIRTBL,TBL:NAME)			 !	SORT BY NAME
	SORT(DIRTBL,TBL:EXT)			 !	SORT BY EXTENSION
	SORT(DIRTBL,TBL:FILESIZE)		 !	SORT BY FILE SIZE
	SORT(DIRTBL,TBL:DATE)			 !	SORT BY DATE
	SORT(DIRTBL,TBL:TIME)			 !	SORT BY TIME
      .						 !    END EXECUTE
      R# = 1					 !    SET RECORD POSITION TO 1
      LOOP I# = 1 TO RECORDS(DIRTBL)		 !    LOOP THRU TABLE
	GET(DIRTBL,I#)				 !    GET ENTRY FROM TABLE
	IF TBL:PORS = '<<SUB DIR>' OR TBL:PORS = '<<PRE DIR>'  !IF PRE OR SUBDIR
	  DELETE(DIRTBL)			 !    DELETE TABLE ENTRY
	  ADD(DIRTBL,R#)			 !    AND ADD IT TO BEGINNING
	  R# += 1				 !    INCREMENT REC POSITION
      . .
    OF	 ENTER_KEY				 !  IF ENTER KEY
    OROF INS_KEY				 !  OR INSERT KEY
    OROF DEL_KEY				 !  OR DELETE KEY
      BEEP					 !    BEEP
      FIRST_NDX = LAST_NDX			 !    SCROLL ZERO LINES
      CYCLE					 !    GO TO TOP OF LOOP
    .						 !  END CASE
    SCROLLIT(SCROLL_GRP)			 !CALL SCROLL PROCEDURE
  .						 !END MAIN LOOP

GET_FILES    ROUTINE

  FREE(DIRTBL)					 !FREE DIRECTORY TABLE
  LOOP NDX = 1 TO 15				 !LOOP THRU REPEAT
    DO CLEAR_LINE				 !  CLEAR THE LINE
  .						 !END LOOP
  DIR" = PATH()					 !ASSIGN CURRENT PATH
  IF LEN(CLIP(DIR")) <> 3			 !IF PATH 3 CHARS 'X:\'
    ROOT" = 'NO'				 !  RESET ROOT DIRECTORY FLAG
    DIR"  = CLIP(DIR") & '\*.*'			 !  SET PATH TO ALL FILES
    R#	  = 2					 !  SET DIR ENTRY POINTER
  ELSE						 !OTHERWISE
    ROOT" = 'YES'				 !  SET ROOT FLAG
    DIR"  = CLIP(DIR") & '*.*'			 !  SET PATH TO ALL FILES
    R#	  = 1					 !  SET DIR ENTRY POINTER
  .						 !END IF
  SETDIR(DIR",DIRGRP)				 !SET PATTERN FOR DIRECTORY
  RECS = 0					 !CLEAR # RECORDS
  DRECS# = 0					 !CLEAR # DIRECTORY RECORDS
  TOTSIZE# = 0					 !CLEAR TOTAL SIZE
  LOOP						 !LOOP THRU DIRECTORY
    NEXTDIR(DIRGRP)				 !  GET A DIRECTORY ENTRY
    GRP:PORS = ''				 !  CLEAR PREVIOUS OR SUB
    IF ERROR() =  'NO MORE FILES' THEN BREAK. ! END LOOP IF NO MORE FILES
    IF GRP:NAME = '.' THEN CYCLE.		 !  IF PREVIOUS DIR THEN CYCLE
    RECS += 1					 !  INCREMENT RECORD COUNTER
    IF BAND(GRP:ATTRIB,10H)			 !  IF ENTRY IS PRE OR SUB DIR
      IF GRP:NAME = '..'			 !    IF PREVIOUS DIRECTORY
	GRP:NAME = '\.. '			 !	DISPLAY PREV SYMBOL
	GRP:PORS = '<<PRE DIR>'			 !	DISPLAY PREVIOUS
      ELSE					 !    OTHERWISE
	GRP:NAME = '\' & GRP:NAME		 !	DISPLAY SUBDIRECTORY
	GRP:PORS = '<<SUB DIR>'			 !	DISPLAY SUB
      .						 !    END IF
      DRECS# += 1				 !    INCREMENT DIRECTORY COUNT
    .						 !  END IF
    TBL:DIRREC = GRP:DIRREC			 !  ASSIGN GROUP TO TABLE
      DOT# = INSTRING('.',GRP:NAME,1)			   !GET DOT POSITION
      IF GRP:PORS  <> '<<SUB DIR>'	  |		   !IF NOT PRE DIRECTORY
      AND GRP:PORS <> '<<PRE DIR>'	  |		   !AND NOT SUB DIRECTRY
      AND DOT#	   <> 0					   !AND FILE HAS AN EXT
	TBL:NAME = SUB(GRP:NAME,1,DOT#-1)		   ! ASSIGN FILE NAME
	TBL:EXT = SUB(GRP:NAME,INSTRING('.',GRP:NAME)+1,3) ! ASSIGN FILE EXT
      ELSE						   !OTHERWISE
	TBL:NAME = GRP:NAME				   ! ASSIGN NAME
	TBL:EXT = ''					   ! CLEAR EXT
      .							   !END IF
    IF TBL:PORS = '<<SUB DIR>'			 !  IF A SUBDIRECTORY
      ADD(DIRTBL,R#)				 !    ADD ENTRY AT BEGINNING
      R# += 1					 !    INCREMENT RECORD POSITION
    ELSE
      ADD(DIRTBL)				 !  ADD TO TABLE
    .
    IF ERROR()					 !  IF THERE WAS AN ERROR
      DO ERROR_RTN				 !    DISPLAY ERROR MESSAGE
    .						 !  END IF
    TOTSIZE# += GRP:FILESIZE			 !  INCREMENT SIZE COUNTER
  .						 !END LOOP

  IF ~RECS THEN RETURN.				 !IF NO RECORDS THEN GOTO MENU.
  CURR_DIR = PATH()				 !DISPLAY CURRENT PATH
  NEW_PTR = 0					 !SET
  NDX = 1					 !   SCROLL
  PTR = 1					 !	INITIALIZATION
  FIRST_NDX = 1					 !	    PARAMETERS
  LAST_NDX = ROWS
  IF RECS < ROWS THEN LAST_NDX = RECS.
  TSIZE = TOTSIZE#				 !DISPLAY TOTAL SIZE COUNTER
  TFILES = RECS-DRECS#				 !DISPLAY TOTAL FILES COUNTER

SHOW_FILES   ROUTINE				 !DISPLAY FILES ON SCREEN

  SAVE_NDX = NDX				 !SAVE THE INDEX
  LOOP NDX = FIRST_NDX TO LAST_NDX		 !LOOP THRU 1 PAGE
    GET(DIRTBL,PTR+NDX-1)			 !GET A TABLE ENTRY
    DO CLEAR_LINE				 !CLEAR THE LINE
    FNAME = TBL:NAME				 !DISPLAY FILENAME
    FEXT = TBL:EXT				 !DISPLAY FILE EXTENSION
    FSIZE = TBL:FILESIZE			 !DISPLAY FILE SIZE
    MINS# = BAND(TBL:TIME,07E0H)		 !GET BITS 5 THRU 10 (MINS)
    MINS# = BSHIFT(MINS#,-5)			 !SHIFT RIGHT 5 BITS
    HOURS# = BAND(TBL:TIME,63488)		 !GETS BITS 11 THRU 15 (HOURS)
    HOURS# = BSHIFT(HOURS#,-11)			 !SHIFT RIGHT 11 BITS
    IF HOURS# > 12				 !IF HOUR > 12 O'CLOCK
      HOURS# -= 12				 !  SUBTRACT 12 (GET STD TIME)
      FAMPM = 'pm'                               !  SET FLAG TO 'PM'
    ELSE					 !OTHERWISE
      FAMPM = 'am'                               !  SET FLAG TO 'AM'
    .						 !END IF
    FHOURS = HOURS#				 !DISPLAY HOURS
    FMINS = MINS#				 !DISPLAY MINUTES
    MONTH# = BAND(TBL:DATE,01E0H)		 !GET BITS 5 THRU 8 (MONTH)
    MONTH# = BSHIFT(MONTH#,-5)			 !SHIFT RIGHT 5 BITS
    DAY# = BAND(TBL:DATE,001FH)			 !GET BITS 0 THRU 4 (DAY)
    YEAR# = BAND(TBL:DATE,0FE00H)		 !GET BITS 9 THRU 15 (YEAR)
    YEAR# = BSHIFT(YEAR#,-9)			 !SHIFT RIGHT 9 BITS
    YEAR# += 80					 !ADD YEAR TO BASE OF 1980
    FMONTH = MONTH#				 !DISPLAY MONTH
    FDAY = DAY#					 !DISPLAY DAY
    FYEAR = YEAR#				 !DISPLAY YEAR
    IF BAND(TBL:ATTRIB,04H)			 !IF BIT 2 ON (SYSTEM FILE)
      FATTR = 'S'				 !  DISPLAY ATTRIBUTE
    .						 !END IF
    IF BAND(TBL:ATTRIB,01H)			 !IF BIT 0 ON (READ ONLY)
      FATTR = CLIP(FATTR) & 'R'			 !  DISPLAY ATTRIBUTE
    .						 !END IF
    IF BAND(TBL:ATTRIB,02H)			 !IF BIT 1 ON (HIDDEN FILE)
      FATTR = CLIP(FATTR) & 'H'			 !  DISPLAY ATTRIBUTE
    .						 !END IF
    IF TBL:PORS = '<<PRE DIR>' OR TBL:PORS = '<<SUB DIR>'  !IF PRE OR SUB DIR
      PRESUB = TBL:PORS					   !  DISPLAY PRE,SUB
  . .						 !END LOOP,   IF
  NDX = SAVE_NDX				 !RESTORE INDEX

CLEAR_LINE   ROUTINE

  FNAME	  = ''					 !CLEAR DIRECTORY SCREEN DISPLAY
  FEXT	  = ''
  FSIZE	  = ''
  PRESUB  = ''
  FMONTH  = ''
  FDAY	  = ''
  FYEAR	  = ''
  FHOURS  = ''
  FMINS	  = ''
  FAMPM	  = ''
  FATTR	  = ''

ERROR_RTN    ROUTINE

  OPEN(ERRWIN)					 !    OPEN ERROR WINDOW
  BEEP						 !    BEEP SPEAKER
  ERRMESS = ERROR() & ' - Press any key'	 !    DISPLAY ERROR MESSAGE
  ERRMESS = CENTER(ERRMESS)			 !    CENTER ERROR MESSAGE
  ASK						 !    WAIT FOR A KEYSTROKE
  CLOSE(ERRWIN)					 !    CLOSE ERROR WINDOW



SCROLLIT     PROCEDURE(SCROLL_PAR)
SCROLL_PAR   EXTERNAL				 !SCROLL GROUP IN CALLER

SCROLL_GRP   GROUP
FLD	       BYTE				 !FIELD NUMBER OF ?POINT
PTR	       LONG				 !POINTER() OF TOP RECORD
NEW_PTR	       LONG				 !POINTER() OF NEW RECORD
NDX	       BYTE				 !REPEAT INDEX
FIRST_NDX      BYTE				 !FIRST ROW TO BE DISPLAYED
LAST_NDX       BYTE				 !LAST ROW TO BE DISPLAYED
ROWS	       BYTE				 !NUMBER OF ROWS TO SCROLL
COLS	       BYTE				 !NUMBER OF COLUMNS TO SCROLL
RECS	       LONG				 !RECORDS() IN FILE
	     .
SAVE_PTR     LONG				 !SAVE AREA FOR PTR
ROW	     BYTE				 !TOP ROW OF SCROLL AREA
COL	     BYTE				 !LEFT COLUMN OF SCROLL AREA

  CODE
  SCROLL_GRP = SCROLL_PAR			 !MOVE THE SCROLL GROUP
  SAVE_PTR = PTR				 !SAVE THE RECORD POINTER
  ROW = ROW(FLD) - NDX + 1			 !SET TOP ROW OF SCROLL AREA
  COL = COL(FLD)				 !SET LEFT COLUMN OF SCROLL AREA

  FIRST_NDX = 1					 !ASSUME DISPLAY OF ALL RECORDS
  LAST_NDX = ROWS				 !
  IF ROWS > RECS				 !ADJUST FOR PARTIAL PAGE
    LAST_NDX = RECS				 !  SET TO LAST RECORD
    BLANK(ROW+RECS,COL,ROWS-RECS,COLS)		 !  CLEAR EXTRA AREA
    IF RECS AND NDX > RECS THEN NDX = RECS.	 ! STOP AT LAST RECORD
  .
  CASE KEYCODE()				 !PROCESS THE KEY

  OF DOWN_KEY					 !DOWN ARROW
    IF PTR <= RECS-LAST_NDX			 !IF THERE ARE MORE RECORDS
      PTR += 1					 !  POINT TO NEXT RECORD
      SCROLL(ROW,COL,ROWS,COLS,1)		 !  SCROLL RECORDS UP
      FIRST_NDX = ROWS				 !  DISPLAY BOTTOM RECORD
    .
  OF PGDN_KEY					 !PAGE DOWN
    IF PTR = RECS-LAST_NDX+1 THEN NDX = LAST_NDX. !IF LAST PAGE POINT TO BOTTOM
    PTR += ROWS					 !  SCROLL DOWN ONE PAGE

  OF CTRL_PGDN					 !CTRL PAGE DOWN
    PTR = RECS - LAST_NDX + 1			 !SCROLL TO LAST PAGE
    NDX = LAST_NDX				 !SET INDEX TO BOTTOM RECORD

  OF UP_KEY					 !UP ARROW
    IF PTR > 1					 !IF THERE ARE MORE RECORDS
      PTR -= 1					 !  POINT TO PREVIOUS RECORD
      SCROLL(ROW,COL,ROWS,COLS,-1)		 !  SCROLL RECORDS DOWN
      LAST_NDX = 1				 !  DISPLAY TOP RECORD
    .
  OF PGUP_KEY					 !PAGE UP
    IF PTR = 1 THEN NDX = 1.			 !IF FIRST PAGE POINT TO TOP
    PTR -= ROWS					 !  SCROLL UP ONE PAGE

  OF CTRL_PGUP					 !CTRL PAGE UP
    PTR = 1					 !SCROLL TO FIRST PAGE
    NDX = 1					 !SET INDEX TO TOP RECORD

  ELSE						 !MUST BE SOME OTHER KEY
    SAVE_PTR = 0				 !FORCE DISPLAY OF ALL RECORDS
    IF NEW_PTR AND NEW_PTR <> PTR+NDX-1		 !IF A RECORD WAS ADDED OR MOVED
      PTR = NEW_PTR - (LAST_NDX/2-1)		 !  CENTER THE RECORD
  . .

  IF PTR > RECS-ROWS+1 THEN PTR = RECS-ROWS+1.	 !CORRECT OVERSHOOT
  IF PTR < 1 THEN PTR = 1.			 !CORRECT UNDERSHOOT
  IF NEW_PTR THEN NDX = NEW_PTR-PTR+1.		 !  SET INDEX AT NEW RECORD
  IF PTR = SAVE_PTR THEN LAST_NDX = 0.		 !NO REDISPLAY FOR SAME RECORDS

  NEW_PTR = 0					 !CLEAR NEW RECORD POINTER
  SCROLL_PAR = SCROLL_GRP			 !SEND THE SCROLL GROUP
  RETURN					 !  AND RETURN

