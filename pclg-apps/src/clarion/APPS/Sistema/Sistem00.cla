Confirma     Screen	  Window(5,39),At(11,21),Hue(15,4)
	       Row(1,1)	  String('…Õ{37}ª')
	       Row(2,1)	  Repeat(3);String('∫<0{37}>∫') .
	       Row(5,1)	  String('»Õ{37}º')
	       Row(2,7)	  String('Pulse [ENTER] para imprimir')
	       Row(4,11)  String('o [ESC] para abortar')
	     .
Abortar	     Screen	  Window(5,39),At(11,21),Hue(15,4)
	       Row(1,1)	  String('…Õ{37}ª')
	       Row(2,1)	  Repeat(3);String('∫<0{37}>∫') .
	       Row(5,1)	  String('»Õ{37}º')
	       Row(3,5)	  String('Pulse [CTRL] [ESC] para abortar')
	     .
TITLE	     Report   Length(90),Width(91),Pre(TTL),Device(MEM:DEVICE)
RPT_HEAD		  Detail
	     .		  .
REPORT	     Report	  Length(96),Width(130),Page(MEM:PAGE),Line(MEM:LINE),Pre(RPT),Device(MEM:DEVICE)
PAGE_HEAD		  Header
		 Col(1)	    Control(2),Use(mem:HPReset)
			    String(' ')
			    Control(5),Use(mem:HPSymbolSet)
		 Col(2)	    Control(6),Use(mem:HPLineas)
			    String(' {31}Guia Telef¢nica {20}')
			    Control(5),Use(MEM:HPUnOctavo)
		 Col(68)    Control(5),Use(MEM:HPComprimido)
	       Row(+1,7)    String('⁄ƒ{57}ø   ⁄ƒ{57}ø')
	       Row(+1,7)    String('≥Nombre {15}Apellido {13}Tel<130>fonos {6}≥   ≥Nombre {15}Apellido {13}Tel<130>fonos {6}≥')
	       Row(+1,7)    String('¿ƒ{57}Ÿ   ¿ƒ{57}Ÿ') Ctl(@LF)
			  .
DETAIL			  Detail
		 Col(8)	    String(20),Use(Izq:NOMBRE)
		 Col(29)    String(20),Use(Izq:APELLIDO)
