	       Row(+1,7)    String('ÀÄ{57}Ù   ÀÄ{57}Ù') Ctl(@LF)
			  .
DETAIL			  Detail
		 Col(8)	    String(20),Use(Izq:NOMBRE)
		 Col(29)    String(20),Use(Izq:APELLIDO)
		 Col(50)    String(15),Use(Izq:Telefono_1)
		 Col(67)    String('³')
		 Col(70)    String(20),Use(Der:NOMBRE)
		 Col(91)    String(20),Use(Der:APELLIDO)
		 Col(112)   String(15),Use(Der:Telefono_1) Ctl(@LF)
			  .
det2			  Detail
		 Col(34)    String(15),Use(Izq:Telefono_3)
		 Col(50)    String(15),Use(Izq:Telefono_2)
		 Col(67)    String('³')
		 Col(96)    String(15),Use(Der:Telefono_3)
		 Col(112)   String(15),Use(Der:Telefono_2) Ctl(@LF)
			  .
RPT_FOOT		  Detail
			  .
PAGE_FOOT		  Footer
		 Col(1)	    Control(2),Use(MEM:HPReset) Ctl(@LF)
	     .		  .

Izquierda      group,pre(Izq)
Nombre		 string(20)
Apellido	 string(20)
Telefono_1	 string(15)
Telefono_2	 string(15)
Telefono_3	 string(15)
	       .
Derecha	       group,pre(Der)
Nombre		 string(20)
Apellido	 string(20)
Telefono_1	 string(15)
Telefono_2	 string(15)
Telefono_3	 string(15)
	       .
  code
  OPEN(Confirma)				 !OPEN THE SCREEN
  ask
  IF KEYCODE() = REJECT_KEY |
